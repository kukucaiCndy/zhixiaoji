.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 168rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: var(--shadow-sm);
  z-index: 100;
  box-sizing: border-box;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 160rpx;
  height: 112rpx;
  position: relative;
  z-index: 1;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.47;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-label {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.tab-item.active .tab-label {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 14rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}
