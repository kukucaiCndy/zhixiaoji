.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 126rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #E2E8F0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  box-sizing: content-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 84rpx;
  gap: 4rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-label {
  font-size: 20rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #94A3B8;
  line-height: 1.4;
}

.tab-item.active .tab-label {
  color: #4F46E5;
  font-weight: 700;
}
