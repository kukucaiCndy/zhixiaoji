.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 168rpx;
  background-image: url('/assets/images/bg/bg_tabbar.png');
  background-size: cover;
  background-position: center;
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.02);
  z-index: 100;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 160rpx;
  height: 112rpx;
  position: relative;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tab-label {
  font-size: 24rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-weight: 400;
  color: #777777;
  line-height: 1.4;
  margin-top: 8rpx;
}

.tab-item.active .tab-label {
  color: #1E3A5F;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #1E3A5F;
}
