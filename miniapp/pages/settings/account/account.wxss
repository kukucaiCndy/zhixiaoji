.account-page {
  width: 100vw;
  min-height: 100vh;
  background: #F0F2F5;
  overflow-x: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  height: 88rpx;
  background: #FFFFFF;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.status-icons {
  display: flex;
  gap: 8rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 36rpx;
  height: 20rpx;
  background: rgba(28, 28, 30, 0.4);
  border-radius: 4rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
}

.back-btn {
  width: 80rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 34rpx;
  color: #1C1C1E;
}

.nav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  text-align: center;
}

.nav-placeholder {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-border {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.05);
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  gap: 32rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.profile-desc {
  font-size: 24rpx;
  color: #8E8E93;
}

.profile-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 0.6rpx;
  padding: 52rpx 32rpx 0;
  height: 106rpx;
  box-sizing: border-box;
}

.setting-group {
  background: #FFFFFF;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 28rpx;
}

.setting-item:first-child {
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon text {
  font-size: 32rpx;
}

.green-bg { background: #E8F8EF; }
.orange-bg { background: #FFF4E5; }
.blue-bg { background: #EEF2FF; }
.purple-bg { background: #F5F3FF; }
.red-bg { background: #FDE8E8; }

.setting-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.setting-desc {
  font-size: 22rpx;
  color: #8E8E93;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.badge {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge.green {
  background: #E8F8EF;
  color: #10B981;
}

.badge.orange {
  background: #FFF4E5;
  color: #F59E0B;
}

.arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}

.footer-text {
  text-align: center;
  font-size: 24rpx;
  color: #C7C7CC;
  padding: 84rpx 120rpx;
}