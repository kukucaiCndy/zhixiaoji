<view class="account-page">
  <view class="status-bar">
    <text class="time">9:41</text>
    <view class="status-icons">
      <view class="signal-bar"></view>
      <view class="signal-bar"></view>
      <view class="signal-bar"></view>
    </view>
  </view>

  <view class="nav-bar">
    <view class="back-btn" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">账号与安全</text>
    <view class="nav-placeholder"></view>
  </view>
  <view class="nav-border"></view>

  <view class="profile-card" bindtap="onEditProfile">
    <view class="profile-avatar">
      <text class="avatar-text">J</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">Jesse</text>
      <text class="profile-desc">ID: 10086 · 微信已绑定</text>
    </view>
    <view class="profile-arrow">›</view>
  </view>

  <view class="section-title">账号绑定</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="wechat-bind">
      <view class="setting-icon green-bg">
        <text>💬</text>
      </view>
      <view class="setting-info">
        <text class="setting-name">微信绑定</text>
        <text class="setting-desc">已绑定微信账号</text>
      </view>
      <view class="setting-right">
        <view class="badge green">已绑定</view>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="phone-bind">
      <view class="setting-icon orange-bg">
        <text>📱</text>
      </view>
      <view class="setting-info">
        <text class="setting-name">手机号</text>
        <text class="setting-desc">绑定手机号增强安全性</text>
      </view>
      <view class="setting-right">
        <view class="badge orange">未绑定</view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-title">安全设置</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="change-password">
      <view class="setting-icon blue-bg">
        <text>🔑</text>
      </view>
      <view class="setting-info">
        <text class="setting-name">修改密码</text>
        <text class="setting-desc">定期更换密码保障账号安全</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="wechat-auth">
      <view class="setting-icon purple-bg">
        <text>🔐</text>
      </view>
      <view class="setting-info">
        <text class="setting-name">微信授权管理</text>
        <text class="setting-desc">管理微信授权范围和权限</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-title">其他</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="account-delete">
      <view class="setting-icon red-bg">
        <text>⚠️</text>
      </view>
      <view class="setting-info">
        <text class="setting-name">账号注销</text>
        <text class="setting-desc">注销后数据将永久删除</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer-text">如遇账号问题，请联系客服 help@zhixiaoji.com</view>
</view>