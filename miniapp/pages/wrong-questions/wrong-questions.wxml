<view class="wrong-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Nav -->
  <nav-bar title="错题本"></nav-bar>

  <!-- Stats -->
  <view class="stats-row">
    <view class="stat-card stat-card--red">
      <image class="stat-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <text class="stat-num">{{totalWrong || 23}}</text>
      <text class="stat-label">累计错题</text>
    </view>
    <view class="stat-card stat-card--amber">
      <image class="stat-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <text class="stat-num">{{pendingCount || 5}}</text>
      <text class="stat-label">待复习</text>
    </view>
  </view>

  <!-- Section title -->
  <text class="section-title">错题记录</text>

  <!-- List -->
  <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wrong-card" wx:for="{{wrongQuestions}}" wx:key="id">
      <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="card-inner">
        <text class="card-question">{{item.question}}</text>
        <view class="card-meta">
          <text class="card-tag">{{item.tag || 'JavaScript'}}</text>
          <text class="card-date">{{item.date}}</text>
        </view>
      </view>
    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
