.wrong-page {
  width: 100vw;
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 顶部区域 */
.header-section {
  background: #FFFFFF;
  border-bottom: 1px solid #F1F5F9;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx;
  height: 44rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.status-icons {
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 6rpx;
  background: #1E293B;
  border-radius: 2rpx;
}

.signal-bar:nth-child(1) { height: 12rpx; }
.signal-bar:nth-child(2) { height: 18rpx; }
.signal-bar:nth-child(3) { height: 24rpx; }

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 56rpx;
  color: #1E293B;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
}

.nav-placeholder {
  width: 72rpx;
  height: 72rpx;
}

/* 标签筛选 */
.filter-section {
  background: #FFFFFF;
  padding: 20rpx 0;
  border-bottom: 1px solid #F1F5F9;
}

.filter-scroll {
  padding: 0 32rpx;
  white-space: nowrap;
}

.filter-list {
  display: flex;
  gap: 16rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  background: #F1F5F9;
  border-radius: 32rpx;
  display: inline-block;
}

.filter-item text {
  font-size: 26rpx;
  font-weight: 500;
  color: #64748B;
}

.filter-item.active {
  background: #4F46E5;
}

.filter-item.active text {
  color: #FFFFFF;
}

/* 错题列表 */
.wrong-list {
  flex: 1;
  padding: 20rpx 32rpx;
}

.wrong-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.wc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.wc-tag {
  padding: 4rpx 20rpx;
  background: #FEF2F2;
  border-radius: 16rpx;
}

.wc-tag text {
  font-size: 22rpx;
  font-weight: 400;
  color: #EF4444;
}

.wc-date {
  display: flex;
  align-items: center;
}

.wc-date text {
  font-size: 24rpx;
  font-weight: 400;
  color: #94A3B8;
}

/* 题目 */
.wc-question {
  margin-bottom: 16rpx;
}

.wc-question text {
  font-size: 30rpx;
  font-weight: 400;
  color: #1E293B;
  line-height: 45rpx;
}

/* 答案对比 */
.wc-answers {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.wc-answer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  flex: 1;
}

.wc-answer-wrong {
  background: #FEF2F2;
}

.wc-answer-correct {
  background: #ECFDF5;
}

.wa-label {
  opacity: 0.7;
}

.wa-label text {
  font-size: 22rpx;
  font-weight: 400;
  white-space: nowrap;
}

.wc-answer-wrong .wa-label text {
  color: #EF4444;
}

.wc-answer-correct .wa-label text {
  color: #10B981;
}

.wa-text {
  font-size: 26rpx;
  font-weight: 400;
  word-break: break-all;
}

.wc-answer-wrong .wa-text {
  color: #EF4444;
}

.wc-answer-correct .wa-text {
  color: #10B981;
}

/* 关联知识点 */
.wc-knowledge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1px solid #F1F5F9;
  flex-wrap: wrap;
}

.wk-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #4F46E5;
}

.wk-tag {
  padding: 4rpx 16rpx;
  background: #EEF2FF;
  border-radius: 12rpx;
}

.wk-tag text {
  font-size: 22rpx;
  font-weight: 400;
  color: #4F46E5;
}

/* 卡片底部（已练习） */
.wc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.wf-status {
  display: flex;
  align-items: center;
}

.wf-status text {
  font-size: 24rpx;
  font-weight: 400;
  color: #10B981;
}

.wf-btn {
  padding: 12rpx 32rpx;
  background: #4F46E5;
  border-radius: 32rpx;
}

.wf-btn text {
  font-size: 24rpx;
  font-weight: 400;
  color: #FFFFFF;
}

/* 底部占位 */
.bottom-placeholder {
  height: 160rpx;
}

/* 底部重练栏 */
.retry-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-top: 1px solid #E2E8F0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.rb-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rb-num text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}

.rb-label text {
  font-size: 24rpx;
  font-weight: 400;
  color: #64748B;
}

.rb-btn {
  padding: 24rpx 48rpx;
  background: #4F46E5;
  border-radius: 44rpx;
}

.rb-btn text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}