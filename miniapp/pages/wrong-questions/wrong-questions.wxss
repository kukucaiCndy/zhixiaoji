.wrong-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.card-bg, .stat-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== Stats ===== */
.stats-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 24rpx;
  margin: 24rpx 48rpx;
}

.stat-card {
  position: relative;
  flex: 1;
  height: 160rpx;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.stat-num {
  position: relative;
  z-index: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 48rpx;
  font-weight: 700;
}

.stat-label {
  position: relative;
  z-index: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.stat-card--red .stat-num { color: var(--color-danger); }
.stat-card--red .stat-label { color: var(--color-text-secondary); }
.stat-card--amber .stat-num { color: var(--color-warning); }
.stat-card--amber .stat-label { color: var(--color-text-secondary); }

/* ===== Section Title ===== */
.section-title {
  position: relative;
  z-index: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin: 8rpx 48rpx 16rpx;
}

/* ===== List ===== */
.list-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 0 48rpx;
}

.bottom-placeholder { height: 40rpx; }

.wrong-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.card-inner {
  position: relative;
  z-index: 1;
  padding: 32rpx;
}

.card-question {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.5;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.card-tag {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.card-date {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
