.container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items : center;
  height: 100vh;
}

.title {
  font-size: 40rpx;
  color: #000000;
  margin-bottom: 20rpx;
}

.weixin-box {
  display: flex;
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  flex-direction: column;
  justify-content: center;
  align-items : center;

}

.weixin-text {
  font-size: 32rpx;
  color: #07c160;
}