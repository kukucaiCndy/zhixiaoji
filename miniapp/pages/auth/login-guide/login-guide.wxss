.login-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ===== Hero 卡片 ===== */
.hero-card {
  position: absolute;
  left: 48rpx;
  top: 200rpx;
  width: 654rpx;
  height: 480rpx;
  border-radius: 40rpx;
  overflow: hidden;
}

.bg-hero {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.hero-logo {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.hero-subtitle {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: normal;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 12rpx;
}

/* ===== 功能特性 ===== */
.feature-list {
  position: absolute;
  left: 48rpx;
  top: 760rpx;
  width: 654rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-card {
  position: relative;
  width: 654rpx;
  height: 144rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
}

.feature-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.feature-icon {
  position: relative;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.feature-icon image {
  width: 48rpx;
  height: 48rpx;
}

.feature-icon-1 { background: var(--color-surface); }
.feature-icon-2 { background: var(--color-accent-light); }
.feature-icon-3 { background: var(--color-divider); }

.feature-text {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-text text:first-child {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
}

.feature-text text:last-child {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

/* ===== 登录按钮 ===== */
.login-btn {
  position: absolute;
  left: 48rpx;
  top: 1360rpx;
  width: 654rpx;
  height: 96rpx;
  background: var(--color-primary);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: 96rpx;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.login-btn--loading {
  opacity: 0.7;
}

.login-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== 游客按钮 ===== */
.guest-btn {
  position: absolute;
  left: 48rpx;
  top: 1476rpx;
  width: 654rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
}

/* ===== 协议文本 ===== */
.terms-text {
  position: absolute;
  left: 96rpx;
  top: 1570rpx;
  width: 560rpx;
  text-align: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.terms-link {
  color: var(--color-primary);
}

/* ===== 授权弹窗 ===== */
.auth-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-mask);
}

.auth-content {
  position: relative;
  width: 560rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 40rpx 32rpx;
  z-index: 1001;
  box-shadow: var(--shadow-modal);
}

.auth-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.auth-title {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.auth-subtitle {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 头像 */
.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-surface);
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-placeholder text {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* 昵称 */
.nickname-wrap {
  margin-bottom: 32rpx;
}

.nickname-label {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

/* 弹窗按钮 */
.auth-btns {
  display: flex;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  background: var(--color-surface);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
}

.confirm-btn.active {
  background: var(--color-primary);
}

.confirm-btn.active text {
  color: #FFFFFF;
}

.skip-btn {
  flex: 1;
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skip-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
}
