.login-page {
  width: 100vw;
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

/* 顶部渐变区域 */
.header-section {
  width: 100%;
  height: 488rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  position: relative;
  overflow: hidden;
}

.status-bar {
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  position: relative;
  z-index: 2;
}

.time {
  font-size: 28rpx;
  font-family: "Microsoft YaHei";
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.signal-icons {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.signal-bar {
  width: 32rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.8);
}

.header-content {
  position: relative;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.decoration-circle {
  width: 400rpx;
  height: 400rpx;
  border-radius: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  position: absolute;
  right: -80rpx;
  top: -120rpx;
}

.decoration-grid {
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  right: 60rpx;
  top: 60rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.grid-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.2);
}

.header-icon {
  position: relative;
  z-index: 2;
}

.book-icon {
  font-size: 128rpx;
  line-height: 1;
}

.decoration-circle-small {
  width: 320rpx;
  height: 320rpx;
  border-radius: 160rpx;
  background: rgba(255, 255, 255, 0.04);
  position: absolute;
  left: -80rpx;
  top: 160rpx;
}

/* 内容区域 */
.content-section {
  flex: 1;
  padding: 0 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -40rpx;
  position: relative;
  z-index: 3;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
}

/* Logo */
.logo-wrap {
  margin-top: -72rpx;
  margin-bottom: 24rpx;
}

.logo-box {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  box-shadow: 0 16rpx 48rpx rgba(79, 70, 229, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  font-size: 72rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1;
}

/* 标题 */
.title-wrap {
  margin-bottom: 16rpx;
}

.title {
  font-size: 52rpx;
  font-family: "Microsoft YaHei";
  font-weight: 700;
  color: #1E293B;
  line-height: 1.3;
  text-align: center;
}

/* 副标题 */
.subtitle-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.subtitle {
  font-size: 30rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #64748B;
  line-height: 1.6;
  text-align: center;
}

/* 功能列表 */
.features-list {
  width: 100%;
  margin-bottom: 64rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-icon text {
  font-size: 36rpx;
  line-height: 1;
}

.feature-icon.blue {
  background: #EEF2FF;
}

.feature-icon.green {
  background: #ECFDF5;
}

.feature-icon.orange {
  background: #FFFBEB;
}

.feature-text {
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 28rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #1E293B;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #94A3B8;
  line-height: 1.4;
}

/* 微信登录按钮 */
button.wechat-btn {
  width: 100%;
  height: 116rpx;
  line-height: 116rpx;
  background: #07C160;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  padding: 0;
  border: none;
  outline: none;
  box-shadow: none;
}

button.wechat-btn::after {
  border: none;
}

button.wechat-btn[loading] {
  opacity: 0.7;
}

.wx-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.wx-text {
  font-size: 32rpx;
  font-family: "Arial";
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}

/* 游客按钮 */
.guest-btn-wrap {
  width: 100%;
  margin-bottom: 32rpx;
  padding: 0 0 24rpx 0;
}

.guest-btn {
  width: 100%;
  height: 110rpx;
  background: #F8FAFC;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.guest-text {
  font-size: 32rpx;
  font-family: "Arial";
  font-weight: 500;
  color: #64748B;
  line-height: 1;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 24rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #94A3B8;
  line-height: 1.6;
}

.agreement-link {
  font-size: 24rpx;
  font-family: "Microsoft YaHei";
  font-weight: 400;
  color: #4F46E5;
  line-height: 1.6;
  margin: 0 8rpx;
}

/* 授权弹窗 - 匹配APP渐变紫色设计风格 */
.auth-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 41, 59, 0.7);
  backdrop-filter: blur(8rpx);
}

.auth-content {
  position: relative;
  width: 560rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
  border-radius: 24rpx;
  padding: 40rpx 40rpx 32rpx;
  z-index: 1001;
  box-shadow: 0 24rpx 80rpx rgba(79, 70, 229, 0.2);
  overflow: hidden;
}

/* 顶部装饰条 */
.auth-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #4F46E5 0%, #06B6D4 100%);
}

.auth-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
  font-family: "Microsoft YaHei";
}

.auth-subtitle {
  display: block;
  font-size: 26rpx;
  color: #64748B;
  font-family: "Microsoft YaHei";
}

/* 头像选择 - 完美圆形 */
.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  margin: 0 auto 32rpx;
  padding: 4rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.3);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  display: block;
  object-fit: cover;
}

.avatar-placeholder {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.avatar-text {
  font-size: 20rpx;
  color: #94A3B8;
}

/* 昵称输入 */
.nickname-wrap {
  margin-bottom: 32rpx;
}

.nickname-label {
  display: block;
  font-size: 26rpx;
  color: #1E293B;
  margin-bottom: 12rpx;
  font-weight: 500;
  font-family: "Microsoft YaHei";
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1E293B;
  box-sizing: border-box;
}

/* 按钮 - 横向排列 */
.auth-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #CBD5E1;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  font-family: "Microsoft YaHei";
  transition: all 0.2s;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.active {
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.4);
}

.confirm-btn::after {
  border: none;
}

.skip-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #F1F5F9;
  color: #64748B;
  font-size: 30rpx;
  border: none;
  font-family: "Microsoft YaHei";
  border-radius: 40rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skip-btn::after {
  border: none;
}
