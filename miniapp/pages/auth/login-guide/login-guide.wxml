<view class="login-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Hero 区域 -->
  <view class="hero-card">
    <image class="bg-hero" src="/assets/images/{{theme}}/bg/bg_hero_card.png" mode="aspectFill" />
    <view class="hero-content">
      <image class="hero-logo" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      <text class="hero-title">知小记</text>
      <text class="hero-subtitle">知识学习伴侣</text>
    </view>
  </view>

  <!-- 功能特性列表 -->
  <view class="feature-list">
    <view class="feature-card">
      <image class="feature-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="feature-icon feature-icon-1">
        <image src="/assets/images/{{theme}}/deco/deco_check.png" mode="aspectFit" />
      </view>
      <view class="feature-text">
        <text>系统化知识卡片</text>
        <text>碎片化时间高效学习</text>
      </view>
    </view>
    <view class="feature-card">
      <image class="feature-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="feature-icon feature-icon-2">
        <image src="/assets/images/{{theme}}/deco/deco_sparkle.png" mode="aspectFit" />
      </view>
      <view class="feature-text">
        <text>智能复习提醒</text>
        <text>基于遗忘曲线科学规划</text>
      </view>
    </view>
    <view class="feature-card">
      <image class="feature-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="feature-icon feature-icon-3">
        <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      </view>
      <view class="feature-text">
        <text>学习社区互动</text>
        <text>与志同道合的伙伴共同进步</text>
      </view>
    </view>
  </view>

  <!-- 微信登录按钮 -->
  <button class="login-btn {{logging ? 'login-btn--loading' : ''}}" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
    <text wx:if="{{!logging}}">微信一键登录</text>
    <text wx:else>登录中...</text>
  </button>

  <!-- 游客模式 -->
  <view class="guest-btn" bindtap="onGuestLogin">
    <text>先逛逛（游客模式）</text>
  </view>

  <!-- 协议文本 -->
  <view class="terms-text">
    <text>登录即代表同意</text>
    <text class="terms-link" bindtap="onTapAgreement">《用户协议》</text>
    <text>和</text>
    <text class="terms-link" bindtap="onTapPrivacy">《隐私政策》</text>
  </view>

  <!-- 授权弹窗 -->
  <view wx:if="{{showAuthModal}}" class="auth-modal">
    <view class="auth-mask" bindtap="onCloseAuth"></view>
    <view class="auth-content">
      <view class="auth-header">
        <text class="auth-title">完善个人信息</text>
        <text class="auth-subtitle">授权获取微信头像和昵称</text>
      </view>
      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatarChange">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-placeholder">
            <image class="avatar-placeholder-icon" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
            <text>点击选择头像</text>
          </view>
        </button>
      </view>
      <view class="nickname-wrap">
        <text class="nickname-label">昵称</text>
        <input
          type="nickname"
          class="nickname-input"
          placeholder="请输入昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      <view class="auth-btns">
        <view class="confirm-btn {{canConfirm ? 'active' : ''}}" bindtap="onConfirmAuth">
          <text>确认</text>
        </view>
        <view class="skip-btn" bindtap="onSkipAuth">
          <text>跳过</text>
        </view>
      </view>
    </view>
  </view>
</view>
