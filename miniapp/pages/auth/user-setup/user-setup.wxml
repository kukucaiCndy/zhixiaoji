<view class="welcome-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- 装饰元素 -->
  <image class="deco deco-wave" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />
  <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-dot" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />

  <!-- 跳过按钮 -->
  <view class="skip-btn" bindtap="onSkip">
    <text>跳过 ›</text>
  </view>

  <!-- 标题区 -->
  <view class="title-area">
    <text class="title">欢迎来到知小记</text>
    <text class="subtitle">选择你感兴趣的方向，\n我们为你定制学习路径</text>
  </view>

  <!-- 标签云 -->
  <view class="tag-cloud">
    <view class="cloud-orbit"></view>
    <view
      wx:for="{{tags}}"
      wx:key="name"
      class="tag tag-{{item.color}} {{item.selected ? 'tag-active' : ''}}"
      style="left:{{item.x}}rpx;top:{{item.y}}rpx;"
      data-index="{{index}}"
      bindtap="onTagTap"
    >
      <image class="tag-icon" src="/assets/images/{{theme}}/deco/deco_check.png" mode="aspectFit" />
      <text>{{item.name}}</text>
    </view>
    <view class="orbit-dot dot-1"></view>
    <view class="orbit-dot dot-2"></view>
    <view class="orbit-dot dot-3"></view>
  </view>

  <!-- 选中提示 -->
  <view class="selected-hint" wx:if="{{selectedCount > 0}}">
    <text>已选 {{selectedCount}} 个方向</text>
  </view>

  <!-- 开始按钮 -->
  <view class="start-btn {{selectedCount > 0 ? 'start-btn--active' : ''}}" bindtap="onStart">
    <text>开始探索</text>
  </view>

  <!-- 底部提示 -->
  <text class="hint-text">随时可以修改偏好</text>
</view>
