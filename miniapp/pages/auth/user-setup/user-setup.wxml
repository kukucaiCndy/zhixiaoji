<view class="user-setup-page">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">完善个人信息</text>
    <text class="subtitle">设置您的昵称和头像</text>
  </view>

  <!-- 头像选择 -->
  <view class="avatar-section">
    <view class="avatar-wrap" bindtap="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"/>
      <view wx:else class="avatar-placeholder">
        <text class="avatar-icon">📷</text>
        <text class="avatar-text">点击选择头像</text>
      </view>
    </view>
  </view>

  <!-- 昵称输入 -->
  <view class="nickname-section">
    <text class="label">昵称</text>
    <input 
      class="nickname-input" 
      placeholder="请输入昵称" 
      value="{{nickname}}"
      bindinput="onNicknameInput"
      maxlength="20"
    />
  </view>

  <!-- 提示信息 -->
  <view class="tips">
    <text class="tip-text">* 跳过将使用默认昵称</text>
  </view>

  <!-- 按钮区域 -->
  <view class="btn-section">
    <button class="save-btn {{canSave ? 'active' : ''}}" bindtap="onSave">保存</button>
    <button class="skip-btn" bindtap="onSkip">跳过</button>
  </view>
</view>
