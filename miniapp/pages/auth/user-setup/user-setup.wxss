.user-setup-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
}

.avatar-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 24rpx;
  color: #999;
}

/* 昵称区域 */
.nickname-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.nickname-input {
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333;
}

/* 提示 */
.tips {
  margin-bottom: 60rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 按钮区域 */
.btn-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.save-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #ccc;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.save-btn.active {
  background: #07c160;
}

.save-btn::after {
  border: none;
}

.skip-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  color: #999;
  font-size: 28rpx;
  border: none;
}

.skip-btn::after {
  border: none;
}
