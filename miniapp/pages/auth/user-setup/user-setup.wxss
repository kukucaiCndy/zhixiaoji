.welcome-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ===== 装饰 ===== */
.deco {
  position: absolute;
  z-index: 2;
  pointer-events: none;
}

.deco-wave { top: 192rpx; left: 400rpx; width: 60rpx; height: 16rpx; }
.deco-star { top: 1160rpx; left: 80rpx; width: 24rpx; height: 24rpx; }
.deco-dot  { top: 360rpx; right: 90rpx; width: 12rpx; height: 12rpx; }

/* ===== 跳过 ===== */
.skip-btn {
  position: absolute;
  top: 104rpx;
  right: 48rpx;
  z-index: 10;
  padding: 8rpx 16rpx;
}

.skip-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ===== 标题 ===== */
.title-area {
  position: absolute;
  top: 192rpx;
  left: 48rpx;
  z-index: 5;
}

.title {
  display: block;
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

/* ===== 标签云 ===== */
.tag-cloud {
  position: absolute;
  top: 400rpx;
  left: 48rpx;
  width: 654rpx;
  height: 760rpx;
  z-index: 5;
}

.cloud-orbit {
  position: absolute;
  top: 40rpx;
  left: 20rpx;
  width: 614rpx;
  height: 600rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-divider);
  pointer-events: none;
}

/* 标签 */
.tag {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  white-space: nowrap;
  transition: all 0.2s;
}

.tag-icon {
  width: 32rpx;
  height: 32rpx;
}

.tag text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.tag-blue   { background: #E8EDF5; }
.tag-blue text   { color: #2D3E5F; }
.tag-warm   { background: #FEF3C7; }
.tag-warm text   { color: #B45309; }
.tag-gray   { background: #F3F4F6; }
.tag-gray text   { color: #4B5563; }
.tag-purple { background: #F3E8FF; }
.tag-purple text { color: #7C3AED; }
.tag-green  { background: #DCFCE7; }
.tag-green text  { color: #16A34A; }

.tag-active.tag-blue   { background: #2D3E5F; }
.tag-active.tag-blue text   { color: #FFFFFF; }
.tag-active.tag-warm   { background: #B45309; }
.tag-active.tag-warm text   { color: #FFFFFF; }
.tag-active.tag-gray   { background: #4B5563; }
.tag-active.tag-gray text   { color: #FFFFFF; }
.tag-active.tag-purple { background: #7C3AED; }
.tag-active.tag-purple text { color: #FFFFFF; }
.tag-active.tag-green  { background: #16A34A; }
.tag-active.tag-green text  { color: #FFFFFF; }

.tag:active {
  transform: scale(0.92);
}

/* 轨道装饰点 */
.orbit-dot {
  position: absolute;
  border-radius: 50%;
  background: var(--color-accent);
  pointer-events: none;
}

.dot-1 { top: 330rpx; left: 28rpx; width: 8rpx; height: 8rpx; }
.dot-2 { top: 360rpx; right: 52rpx; width: 6rpx; height: 6rpx; }
.dot-3 { top: 636rpx; left: 310rpx; width: 8rpx; height: 8rpx; }

/* ===== 选中提示 ===== */
.selected-hint {
  position: absolute;
  left: 48rpx;
  top: 1180rpx;
  z-index: 10;
}

.selected-hint text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-surface);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* ===== 开始按钮 ===== */
.start-btn {
  position: absolute;
  left: 48rpx;
  top: 1240rpx;
  width: 654rpx;
  height: 104rpx;
  background: #CBD5E1;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background 0.2s;
}

.start-btn--active {
  background: var(--color-primary);
}

.start-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.start-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ===== 底部提示 ===== */
.hint-text {
  position: absolute;
  left: 48rpx;
  top: 1370rpx;
  width: 654rpx;
  text-align: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  z-index: 5;
}
