<view class="profile-page">
  <view class="nav-bar">
    <text class="nav-title">我的</text>
    <view class="nav-setting" bindtap="onSetting" data-action="settings">
      <text>⚙️ 设置</text>
    </view>
  </view>

  <view class="user-section">
    <view class="avatar-wrap">
      <view class="avatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <text wx:else class="avatar-text">{{userInfo.nickname[0] || '?'}}</text>
      </view>
      <view class="avatar-edit" bindtap="onEditProfile">
        <text>✏️</text>
      </view>
    </view>
    <view class="user-detail">
      <view class="user-top">
        <text class="username">{{userInfo.nickname || '未登录'}}</text>
        <text class="user-id">ID: {{userInfo.userId || '---'}}</text>
      </view>
      <view class="user-level-row">
        <view class="level-badge">
          <text class="level-text">Lv.{{userInfo.level || 0}}</text>
        </view>
        <text class="level-desc">已学习 {{userInfo.learnedCards || 0}} 张卡片</text>
      </view>
      <view class="user-stats">
        <view class="user-stat-item">
          <text class="stat-num">{{userInfo.level || 0}}</text>
          <text class="stat-label">等级</text>
        </view>
        <view class="user-stat-item">
          <text class="stat-num">{{userInfo.learnedCards || 0}}</text>
          <text class="stat-label">学习卡片</text>
        </view>
        <view class="user-stat-item">
          <text class="stat-num">{{userInfo.points || 0}}</text>
          <text class="stat-label">积分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="points-section">
    <view class="points-card">
      <view class="points-left">
        <view class="points-label">我的积分</view>
        <text class="points-num">{{userInfo.points || 0}}</text>
      </view>
      <view class="points-actions">
        <view class="points-btn" bindtap="onNavigate" data-url="/pages/points/shop/shop">
          <text>📦 积分商城</text>
        </view>
        <view class="points-btn" bindtap="onNavigate" data-url="/pages/points/detail/detail">
          <text>📊 积分明细</text>
        </view>
      </view>
    </view>
  </view>

  <view class="func-grid-wrap">
    <view class="func-grid">
      <view class="func-item" bindtap="onMenuItem" data-action="rank">
        <view class="func-icon-wrap">
          <text class="func-icon">🏆</text>
        </view>
        <text class="func-name">排行榜</text>
        <text class="func-desc">本周排名</text>
      </view>
      <view class="func-item" bindtap="onMenuItem" data-action="achievements">
        <view class="func-icon-wrap">
          <text class="func-icon">🎖️</text>
        </view>
        <text class="func-name">成就中心</text>
        <text class="func-desc">敬请期待</text>
      </view>
      <view class="func-item" bindtap="onMenuItem" data-action="learn-stats">
        <view class="func-icon-wrap">
          <text class="func-icon">📈</text>
        </view>
        <text class="func-name">学习统计</text>
        <text class="func-desc">详细数据</text>
      </view>
      <view class="func-item" bindtap="onMenuItem" data-action="wrong-questions">
        <view class="func-icon-wrap">
          <text class="func-icon">❌</text>
        </view>
        <text class="func-name">错题本</text>
        <text class="func-desc">敬请期待</text>
      </view>
      <view class="func-item" bindtap="onMenuItem" data-action="favorites">
        <view class="func-icon-wrap">
          <text class="func-icon">⭐</text>
        </view>
        <text class="func-name">收藏夹</text>
        <text class="func-desc">敬请期待</text>
      </view>
      <view class="func-item" bindtap="onMenuItem" data-action="desk">
        <view class="func-icon-wrap">
          <text class="func-icon">🖥️</text>
        </view>
        <text class="func-name">我的书桌</text>
        <text class="func-desc">敬请期待</text>
      </view>
    </view>
  </view>

  <view class="overview-section">
    <view class="overview-title">
      <text>📊 学习概览</text>
    </view>
    <view class="overview-stats">
      <view class="overview-item">
        <text class="overview-num">{{userInfo.learnedCards || 0}}</text>
        <text class="overview-label">学习卡片</text>
      </view>
      <view class="overview-item">
        <text class="overview-num">{{userInfo.points || 0}}</text>
        <text class="overview-label">积分</text>
      </view>
      <view class="overview-item">
        <text class="overview-num">{{userInfo.level || 0}}</text>
        <text class="overview-label">等级</text>
      </view>
    </view>
  </view>

  <view class="settings-card">
    <view class="setting-item" bindtap="onSetting" data-action="theme">
      <view class="setting-icon-wrap">
        <text>🎨</text>
      </view>
      <text class="setting-label">主题设置</text>
      <text class="setting-value">清新蓝绿</text>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="review-plan">
      <view class="setting-icon-wrap">
        <text>📅</text>
      </view>
      <text class="setting-label">复习计划</text>
      <text class="setting-value">艾宾浩斯</text>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="notification">
      <view class="setting-icon-wrap">
        <text>🔔</text>
      </view>
      <text class="setting-label">通知设置</text>
      <text class="setting-value">已开启</text>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="account">
      <view class="setting-icon-wrap">
        <text>🔒</text>
      </view>
      <text class="setting-label">账号与安全</text>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="help">
      <view class="setting-icon-wrap">
        <text>💬</text>
      </view>
      <text class="setting-label">帮助与反馈</text>
      <view class="setting-arrow">›</view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="about">
      <view class="setting-icon-wrap">
        <text>ℹ️</text>
      </view>
      <text class="setting-label">关于我们</text>
      <text class="setting-value">v1.0.0</text>
      <view class="setting-arrow">›</view>
    </view>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <tab-bar activeIndex="3" bind:change="onTabChange"></tab-bar>
</view>
