<view class="profile-page">
  <!-- 顶部用户信息 -->
  <view class="header-section">
    <view class="status-bar">
      <text class="time">9:41</text>
      <view class="status-icons">
        <view class="signal-bar"></view>
        <view class="signal-bar"></view>
        <view class="signal-bar"></view>
      </view>
    </view>
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-text">J</text>
      </view>
      <view class="user-info">
        <text class="username">Jesse</text>
        <view class="level-badge">
          <text class="level-icon">⭐</text>
          <text class="level-text">Lv.5</text>
        </view>
      </view>
      <view class="edit-btn" bindtap="onEditProfile">
        <text>编辑</text>
      </view>
    </view>
  </view>

  <!-- 学习统计 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-number">36</text>
      <text class="stat-label">学习天数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">47</text>
      <text class="stat-label">已掌握</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">1,280</text>
      <text class="stat-label">积分</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuItem" data-action="learn-record">
      <view class="menu-icon">
        <text>📖</text>
      </view>
      <text class="menu-label">学习记录</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-action="favorites">
      <view class="menu-icon">
        <text>❤️</text>
      </view>
      <text class="menu-label">我的收藏</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-action="wrong-questions">
      <view class="menu-icon">
        <text>❌</text>
      </view>
      <text class="menu-label">错题本</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-action="achievements">
      <view class="menu-icon">
        <text>🏆</text>
      </view>
      <text class="menu-label">成就系统</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-action="desk">
      <view class="menu-icon">
        <text>🎨</text>
      </view>
      <text class="menu-label">我的书桌</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-action="invite">
      <view class="menu-icon">
        <text>🎁</text>
      </view>
      <text class="menu-label">邀请好友</text>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
  </view>

  <!-- 设置区域 -->
  <view class="settings-section">
    <view class="setting-item" bindtap="onSetting" data-action="notification">
      <view class="setting-icon">
        <text>🔔</text>
      </view>
      <text class="setting-label">消息通知</text>
      <view class="setting-right">
        <text class="setting-value">已开启</text>
        <view class="setting-arrow">
          <text>›</text>
        </view>
      </view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="help">
      <view class="setting-icon">
        <text>❓</text>
      </view>
      <text class="setting-label">帮助与反馈</text>
      <view class="setting-arrow">
        <text>›</text>
      </view>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="about">
      <view class="setting-icon">
        <text>ℹ️</text>
      </view>
      <text class="setting-label">关于我们</text>
      <view class="setting-right">
        <text class="setting-value">v1.0.0</text>
        <view class="setting-arrow">
          <text>›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部 Tab Bar -->
  <tab-bar activeIndex="3" bind:change="onTabChange"></tab-bar>
</view>
