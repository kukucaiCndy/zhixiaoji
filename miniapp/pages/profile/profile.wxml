<view class="profile-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Header -->
  <view class="header">
    <image class="header-bg" src="/assets/images/{{theme}}/bg/bg_navbar.png" mode="aspectFill" />
    <text class="title">我的</text>
  </view>

  <!-- 装饰 -->
  <image class="deco deco-wave" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />
  <image class="deco deco-circle" src="/assets/images/{{theme}}/deco/deco_circle.png" mode="aspectFit" />
  <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-dot" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">

      <!-- User Card -->
      <view class="user-card" bindtap="onEditProfile">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_user_card.png" mode="aspectFill" />
        <view class="avatar-wrap">
          <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
          <image wx:else class="avatar-placeholder" src="/assets/images/icons/icon_user_avatar.png" mode="aspectFit" />
        </view>
        <text class="user-name">{{userInfo.nickname || '学习者'}}</text>
        <text class="user-id">ID: {{userInfo.userId || '8829301'}}</text>
        <view class="user-score">
          <text class="score-val">{{userInfo.points || '1,280'}}</text>
        </view>
      </view>

      <!-- Menu List -->
      <view class="menu-list">
        <view class="menu-item" bindtap="onMenuItem" data-action="achievements">
          <image class="menu-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
          <view class="menu-icon menu-icon-1">
            <image src="/assets/images/icons/icon_trophy_new.png" mode="aspectFit" />
          </view>
          <text class="menu-label">我的成就</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onMenuItem" data-action="favorites">
          <image class="menu-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
          <view class="menu-icon menu-icon-2">
            <image src="/assets/images/icons/icon_bookmark_new.png" mode="aspectFit" />
          </view>
          <text class="menu-label">收藏内容</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onSetting" data-action="settings">
          <image class="menu-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
          <view class="menu-icon menu-icon-3">
            <image src="/assets/images/icons/icon_settings_new.png" mode="aspectFit" />
          </view>
          <text class="menu-label">设置</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onSetting" data-action="about">
          <image class="menu-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
          <view class="menu-icon menu-icon-3">
            <image src="/assets/images/icons/icon_info_new.png" mode="aspectFit" />
          </view>
          <text class="menu-label">关于</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onSetting" data-action="preferences">
          <image class="menu-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
          <view class="menu-icon menu-icon-2">
            <image src="/assets/images/icons/icon_sliders.png" mode="aspectFit" />
          </view>
          <text class="menu-label">学习偏好</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <tab-bar activeIndex="2" bind:change="onTabChange"></tab-bar>
</view>
