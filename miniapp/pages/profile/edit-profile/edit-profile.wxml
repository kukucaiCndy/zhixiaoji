<view class="edit-page">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" catch:tap="onBack">
        <text class="nav-back-icon">&lt;</text>
      </view>
      <text class="nav-title">编辑资料</text>
      <view class="nav-save {{saving ? 'nav-save-disabled' : ''}}" catch:tap="onSave">
        <text class="nav-save-text">保存</text>
      </view>
    </view>
  </view>

  <view class="edit-content" style="padding-top: {{statusBarHeight + 88}}rpx;">
    <view class="avatar-section" catch:tap="onChooseAvatar">
      <image class="edit-avatar" src="{{avatarUrl || '../../images/default-avatar.png'}}" mode="aspectFill" />
      <text class="avatar-hint">点击更换头像</text>
    </view>

    <view class="form-section">
      <view class="form-group">
        <text class="form-label">昵称</text>
        <input class="form-input" type="text" value="{{nickname}}" placeholder="请输入昵称" maxlength="20" bindinput="onNicknameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">个性签名</text>
        <input class="form-input" type="text" value="{{bio}}" placeholder="选填：一句话介绍自己" maxlength="50" bindinput="onBioInput" />
      </view>
    </view>
  </view>
</view>
