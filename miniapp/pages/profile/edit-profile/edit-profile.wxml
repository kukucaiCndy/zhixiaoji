<view class="edit-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- 装饰元素 -->
  <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-dot" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />

  <!-- 导航栏 -->
  <nav-bar title="编辑资料"></nav-bar>

  <!-- 头像区域 -->
  <view class="avatar-section" bindtap="onChooseAvatar">
    <view class="avatar-wrap">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <view class="user-icon">
          <view class="user-icon-head"></view>
          <view class="user-icon-body"></view>
        </view>
      </view>
      <!-- 相机徽章 -->
      <view class="camera-badge">
        <view class="camera-body">
          <view class="camera-lens"></view>
        </view>
      </view>
    </view>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <!-- 分区标题 -->
  <text class="section-title">个人信息</text>

  <!-- 表单 -->
  <view class="form">
    <view class="form-item" bindtap="onEditNickname" data-field="nickname">
      <text class="form-label">昵称</text>
      <text class="form-value">{{nickname || '学习者'}}</text>
    </view>
    <view class="form-item" bindtap="onEditBio" data-field="bio">
      <text class="form-label">个人简介</text>
      <text class="form-value">{{bio || '热爱学习，不断进步'}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <text class="form-value">138****8888</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="onSave">
    <text class="save-btn-text">保存</text>
  </view>
</view>
