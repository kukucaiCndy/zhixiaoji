<view class="edit-page">
  <view class="nav-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="back-btn" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="nav-title">编辑资料</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="avatar-section" bindtap="onChooseAvatar">
    <view class="avatar">
      <text class="avatar-text">{{avatarLetter || 'J'}}</text>
    </view>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <view class="section-title">账号</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onEditNickname">
      <view class="setting-icon gray-bg"><text>👤</text></view>
      <view class="setting-info">
        <text class="setting-name">昵称</text>
      </view>
      <text class="setting-value">{{nickname || 'Jesse'}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditBio">
      <view class="setting-icon yellow-bg"><text>🏅</text></view>
      <view class="setting-info">
        <text class="setting-name">个性签名</text>
      </view>
      <text class="setting-value">{{bio || '努力学习前端中...'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-title">个人信息</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onEditGender">
      <view class="setting-icon purple-bg"><text>📅</text></view>
      <view class="setting-info">
        <text class="setting-name">性别</text>
      </view>
      <text class="setting-value">{{gender || '男'}}</text>
      <text class="arrow">›</text>
    </view>
    <picker mode="date" value="{{birthday}}" start="1900-01-01" end="2099-12-31" bindchange="onBirthdayChange">
      <view class="setting-item">
        <view class="setting-icon cyan-bg"><text>📆</text></view>
        <view class="setting-info">
          <text class="setting-name">生日</text>
        </view>
        <text class="setting-value">{{birthday || '1998-06-15'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <view class="setting-item" bindtap="onEditEmail">
      <view class="setting-icon green-bg"><text>📬</text></view>
      <view class="setting-info">
        <text class="setting-name">邮箱</text>
      </view>
      <text class="setting-value">{{email || '未设置'}}</text>
      <text class="arrow">›</text>
    </view>
    <picker mode="region" value="{{locationRegion}}" bindchange="onLocationChange">
      <view class="setting-item">
        <view class="setting-icon gray-bg"><text>🌍</text></view>
        <view class="setting-info">
          <text class="setting-name">所在地</text>
        </view>
        <text class="setting-value">{{location || '广东深圳'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="bottom-action">
    <view class="bottom-save-btn" bindtap="onSave">
      <text wx:if="{{!saving}}" class="bottom-save-text">保存</text>
      <view wx:else class="bottom-save-loading">
        <view class="bottom-save-loading-dot"></view>
        <view class="bottom-save-loading-dot"></view>
        <view class="bottom-save-loading-dot"></view>
      </view>
    </view>
  </view>
</view>
