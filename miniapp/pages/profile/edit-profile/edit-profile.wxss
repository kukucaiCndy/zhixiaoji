/* ============================================
   知小记 · 编辑资料 — Pencil aV3zb 1:1 像素级复刻
   设计稿 375px → 小程序 750rpx (×2)
   颜色: 全部走 CSS 变量，支持 light/dark 切换
   ============================================ */

.edit-page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ===== 装饰元素 ===== */
.deco {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

.deco-star { top: 150rpx; right: 46rpx; width: 24rpx; height: 24rpx; }
.deco-dot  { top: 1200rpx; left: 60rpx; width: 10rpx; height: 10rpx; }

/* ===== 头像区域 ===== */
.avatar-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.avatar-wrap {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 96rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 96rpx;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.user-icon-head {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.user-icon-body {
  width: 44rpx;
  height: 26rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: #FFFFFF;
  margin-top: 6rpx;
}

/* ===== 相机徽章 ===== */
.camera-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-body {
  width: 28rpx;
  height: 20rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.camera-body::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 9rpx;
  width: 8rpx;
  height: 4rpx;
  background: var(--color-primary);
  border: 2rpx solid #FFFFFF;
  border-bottom: none;
  border-radius: 2rpx 2rpx 0 0;
}

.camera-lens {
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
}

/* ===== 头像提示文字 ===== */
.avatar-hint {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  width: 310rpx;
  margin-top: 16rpx;
}

/* ===== 分区标题 ===== */
.section-title {
  display: block;
  position: relative;
  z-index: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-top: 32rpx;
  margin-left: 48rpx;
}

/* ===== 表单 ===== */
.form {
  position: relative;
  z-index: 1;
  margin: 16rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
}

.form-label {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.form-value {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.3;
}

/* ===== 保存按钮 ===== */
.save-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin: 50rpx 48rpx 48rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.save-btn-text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
