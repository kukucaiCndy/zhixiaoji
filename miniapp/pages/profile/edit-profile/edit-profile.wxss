.edit-page {
  min-height: 100vh;
  background: #F5F5F7;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  z-index: 100;
}

.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 36rpx;
  color: #1C1C1E;
  font-weight: 500;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.nav-save {
  min-width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #4F46E5;
  border-radius: 30rpx;
  padding: 0 20rpx;
}

.nav-save-disabled {
  opacity: 0.5;
}

.nav-save-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.edit-content {
  padding: 0 30rpx 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F2F2F7;
  margin-bottom: 16rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.avatar-hint {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.form-group {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
  min-height: 88rpx;
  box-sizing: border-box;
}

.form-group:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #1C1C1E;
  width: 140rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  line-height: 1.4;
  height: 60rpx;
}
