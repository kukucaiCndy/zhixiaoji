.edit-page {
  width: 100vw;
  min-height: 100vh;
  background: #FFFFFF;
  overflow-x: hidden;
}

.nav-header {
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 0 0 32rpx;
  background: #FFFFFF;
}

.back-btn {
  width: 80rpx;
  flex-shrink: 0;
}

.back-icon {
  font-size: 34rpx;
  color: #1C1C1E;
}

.nav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  color: #1C1C1E;
}

.nav-placeholder {
  width: 80rpx;
  flex-shrink: 0;
}

.bottom-action {
  display: flex;
  justify-content: center;
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.bottom-save-btn {
  width: 600rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-save-loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.bottom-save-loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 50%;
  animation: dot-pulse 0.8s ease-in-out infinite;
}

.bottom-save-loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.bottom-save-loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 16rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.avatar-hint {
  font-size: 22rpx;
  color: #8E8E93;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 0.6rpx;
  padding: 0 32rpx;
  height: 106rpx;
  line-height: 106rpx;
}

.setting-group {
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 28rpx;
}

.setting-item:not(:last-child) {
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon text {
  font-size: 32rpx;
}

.gray-bg { background: #F0F2F5; }
.yellow-bg { background: #FFF4E5; }
.purple-bg { background: #F5F3FF; }
.cyan-bg { background: #ECFEFF; }
.green-bg { background: #E8F8EF; }

.setting-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.setting-value {
  font-size: 22rpx;
  color: #8E8E93;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}
