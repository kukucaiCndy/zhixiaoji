.settings-page {
  width: 100vw;
  min-height: 100vh;
  background: #FFFFFF;
  overflow-x: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  height: 88rpx;
  background: #FFFFFF;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.status-icons {
  display: flex;
  gap: 8rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 36rpx;
  height: 20rpx;
  background: rgba(28, 28, 30, 0.4);
  border-radius: 4rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
}

.back-btn {
  width: 80rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 34rpx;
  color: #1C1C1E;
}

.nav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  color: #1C1C1E;
  letter-spacing: 0.4rpx;
}

.nav-placeholder {
  width: 80rpx;
  flex-shrink: 0;
}

.nav-border {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.05);
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 28rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.profile-avatar .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 48rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #FFFFFF;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.profile-desc {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.profile-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 0.6rpx;
  padding: 0 32rpx;
  height: 106rpx;
  line-height: 106rpx;
}

.setting-group {
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 28rpx;
}

.setting-item:not(:last-child) {
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon text {
  font-size: 32rpx;
}

.blue-bg { background: #EEF2FF; }
.orange-bg { background: #FFF4E5; }
.green-bg { background: #E8F8EF; }
.purple-bg { background: #F5F3FF; }
.gray-bg { background: #F0F2F5; }

.setting-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.setting-value {
  font-size: 22rpx;
  color: #8E8E93;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}