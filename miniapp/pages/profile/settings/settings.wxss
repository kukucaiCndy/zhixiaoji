.settings-page {
  position: relative;
  min-height: 100vh;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ===== Menu ===== */
.menu-list {
  position: relative;
  z-index: 1;
  margin: 48rpx 48rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  position: relative;
  height: 112rpx;
}

.menu-item-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.menu-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 112rpx;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon image { width: 32rpx; height: 32rpx; }

.menu-icon-1 { background: var(--color-surface); }
.menu-icon-2 { background: var(--color-accent-light); }
.menu-icon-3 { background: var(--color-divider); }

.menu-label {
  flex: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  margin-left: 24rpx;
}

.menu-value {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-right: 8rpx;
}

.menu-arrow {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx;
  color: var(--color-text-tertiary);
}

/* ===== Version ===== */
.version {
  display: block;
  text-align: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 40rpx;
}

/* ===== Logout ===== */
.logout-btn {
  position: relative;
  z-index: 1;
  margin: 24rpx 48rpx 0;
  width: 654rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-danger);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
