<view class="settings-page">
  <view class="status-bar">
    <text class="time">9:41</text>
    <view class="status-icons">
      <view class="signal-bar"></view>
      <view class="signal-bar"></view>
      <view class="signal-bar"></view>
    </view>
  </view>

  <view class="nav-bar">
    <view class="back-btn" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">设置</text>
    <view class="nav-placeholder"></view>
  </view>
  <view class="nav-border"></view>

  <view class="profile-card" bindtap="onEditProfile">
    <view class="profile-avatar">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{userInfo.nickname[0] || 'J'}}</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{userInfo.nickname || 'Jesse'}}</text>
      <text class="profile-desc">ID: {{userInfo.userId || '10086'}}</text>
    </view>
    <view class="profile-arrow">›</view>
  </view>

  <view class="section-title">个性化</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="theme">
      <view class="setting-icon blue-bg"><text>🎨</text></view>
      <view class="setting-info">
        <text class="setting-name">主题设置</text>
      </view>
      <text class="setting-value">清新蓝绿</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="home-layout">
      <view class="setting-icon orange-bg"><text>📋</text></view>
      <view class="setting-info">
        <text class="setting-name">首页布局</text>
      </view>
      <text class="setting-value">自定义模块排序</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="review-plan">
      <view class="setting-icon green-bg"><text>🔄</text></view>
      <view class="setting-info">
        <text class="setting-name">复习计划</text>
      </view>
      <text class="setting-value">艾宾浩斯间隔</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-title">通知</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="notification">
      <view class="setting-icon blue-bg"><text>🔔</text></view>
      <view class="setting-info">
        <text class="setting-name">通知设置</text>
      </view>
      <text class="setting-value">管理推送提醒</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="messages">
      <view class="setting-icon purple-bg"><text>📨</text></view>
      <view class="setting-info">
        <text class="setting-name">消息通知</text>
      </view>
      <text class="setting-value">{{messageCount || '3'}} 条未读</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-title">账户</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="account">
      <view class="setting-icon purple-bg"><text>🔐</text></view>
      <view class="setting-info">
        <text class="setting-name">账号与安全</text>
      </view>
      <text class="setting-value">微信已绑定</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section-title">其他</view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onSetting" data-action="help">
      <view class="setting-icon gray-bg"><text>💬</text></view>
      <view class="setting-info">
        <text class="setting-name">帮助与反馈</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="about">
      <view class="setting-icon gray-bg"><text>ℹ️</text></view>
      <view class="setting-info">
        <text class="setting-name">关于我们</text>
      </view>
      <text class="setting-value">v1.0.0</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onSetting" data-action="clear-cache">
      <view class="setting-icon gray-bg"><text>🗑️</text></view>
      <view class="setting-info">
        <text class="setting-name">清除缓存</text>
      </view>
      <text class="setting-value">{{cacheSize || '12.5 MB'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>