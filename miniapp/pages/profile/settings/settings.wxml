<view class="settings-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Nav -->
  <nav-bar title="设置"></nav-bar>

  <!-- Menu -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onSetting" data-action="notification">
      <image class="menu-item-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="menu-content">
        <view class="menu-icon menu-icon-1">
          <image src="/assets/images/{{theme}}/deco/deco_check.png" mode="aspectFit" />
        </view>
        <text class="menu-label">消息通知</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onSetting" data-action="theme">
      <image class="menu-item-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="menu-content">
        <view class="menu-icon menu-icon-2">
          <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
        </view>
        <text class="menu-label">深色模式</text>
        <text class="menu-value">{{themeLabel}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onSetting" data-action="clear-cache">
      <image class="menu-item-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="menu-content">
        <view class="menu-icon menu-icon-3">
          <image src="/assets/images/{{theme}}/deco/deco_spiral.png" mode="aspectFit" />
        </view>
        <text class="menu-label">清除缓存</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onSetting" data-action="privacy">
      <image class="menu-item-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="menu-content">
        <view class="menu-icon menu-icon-3">
          <image src="/assets/images/{{theme}}/deco/deco_circle.png" mode="aspectFit" />
        </view>
        <text class="menu-label">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onSetting" data-action="about">
      <image class="menu-item-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
      <view class="menu-content">
        <view class="menu-icon menu-icon-2">
          <image src="/assets/images/{{theme}}/deco/deco_sparkle.png" mode="aspectFit" />
        </view>
        <text class="menu-label">关于知小记</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <text class="version">版本 v1.2.0</text>

  <view class="logout-btn" bindtap="onLogout">
    <text>退出登录</text>
  </view>
</view>
