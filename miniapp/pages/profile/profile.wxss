.profile-page {
  width: 100vw;
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 顶部区域 */
.header-section {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  padding-bottom: 40rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx;
  height: 44rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.status-icons {
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 6rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.signal-bar:nth-child(1) { height: 12rpx; }
.signal-bar:nth-child(2) { height: 18rpx; }
.signal-bar:nth-child(3) { height: 24rpx; }

.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  background: #06B6D4;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.level-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  display: inline-flex;
}

.level-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.level-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.edit-btn {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
}

.edit-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 学习统计 */
.stats-section {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: -20rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #F1F5F9;
}

/* 功能菜单 */
.menu-section {
  margin: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon text {
  font-size: 36rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
}

.menu-arrow {
  width: 32rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-arrow text {
  font-size: 32rpx;
  color: #94A3B8;
}

/* 设置区域 */
.settings-section {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.setting-icon text {
  font-size: 36rpx;
}

.setting-label {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-value {
  font-size: 26rpx;
  color: #94A3B8;
}

.setting-arrow {
  width: 32rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-arrow text {
  font-size: 32rpx;
  color: #94A3B8;
}

/* 退出登录 */
.logout-section {
  margin: 24rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 98rpx;
  background: #FFFFFF;
  border: 2rpx solid #EF4444;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn text {
  font-size: 28rpx;
  color: #EF4444;
}

/* 底部占位 */
.bottom-placeholder {
  height: 160rpx;
}
