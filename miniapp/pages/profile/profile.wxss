.profile-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.scroll-content {
  flex: 1;
  position: relative;
  z-index: 1;
}

.scroll-inner {
  position: relative;
  padding: 8rpx 48rpx 0;
}

.bottom-placeholder { height: 168rpx; }

/* ===== Header ===== */
.header {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 192rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.title {
  position: absolute;
  left: 48rpx;
  top: 54rpx;
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* ===== User Card ===== */
.user-card {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.avatar-wrap {
  position: absolute;
  left: 40rpx;
  top: 56rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 56rpx;
}

.avatar-placeholder {
  width: 48rpx;
  height: 48rpx;
}

.user-name {
  position: absolute;
  left: 184rpx;
  top: 64rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.user-id {
  position: absolute;
  left: 184rpx;
  top: 116rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.user-score {
  position: absolute;
  right: 38rpx;
  top: 76rpx;
  width: 136rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-val {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-warning);
}

/* ===== Menu ===== */
.menu-list {
  width: 100%;
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 112rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
}

.menu-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.menu-icon {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon image { width: 32rpx; height: 32rpx; }

.menu-icon-1 { background: var(--color-accent-light); }
.menu-icon-2 { background: var(--color-surface); }
.menu-icon-3 { background: var(--color-divider); }

.menu-label {
  position: relative;
  z-index: 1;
  flex: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  margin-left: 24rpx;
}

.menu-arrow {
  position: absolute;
  z-index: 1;
  left: 590rpx;
  top: 36rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

/* ===== 装饰 ===== */
.deco {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

.deco-wave   { top: 110rpx; right: 70rpx;  width: 40rpx; height: 12rpx; }
.deco-circle { top: 500rpx; left: 80rpx;  width: 16rpx; height: 16rpx; }
.deco-star   { top: 480rpx; right: 90rpx;  width: 20rpx; height: 20rpx; }
.deco-dot    { top: 1120rpx; left: 100rpx; width: 10rpx; height: 10rpx; }
