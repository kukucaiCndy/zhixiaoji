.profile-page {
  width: 100vw;
  min-height: 100vh;
  background: #F8FAFC;
  overflow-x: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  height: 88rpx;
  background: #4F46E5;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.status-icons {
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 12rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 4rpx;
}

.signal-bar:nth-child(1) { height: 20rpx; }
.signal-bar:nth-child(2) { height: 20rpx; }
.signal-bar:nth-child(3) { height: 20rpx; }

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 106rpx;
  padding: 16rpx 32rpx 32rpx;
  background: #4F46E5;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.nav-setting {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-section {
  background: #FFFFFF;
  padding: 40rpx 32rpx;
  display: flex;
  gap: 28rpx;
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: #F59E0B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFFFFF;
}

.avatar-edit text {
  font-size: 24rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
}

.user-id {
  font-size: 24rpx;
  color: #64748B;
}

.user-level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.level-badge {
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
  padding: 2rpx 16rpx;
  border-radius: 16rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.level-desc {
  font-size: 22rpx;
  color: #64748B;
}

.user-stats {
  display: flex;
  gap: 32rpx;
  margin-top: 8rpx;
}

.user-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
}

.points-section {
  padding: 0 32rpx 32rpx;
}

.points-card {
  width: 686rpx;
  height: 174rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.points-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.points-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.points-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: center;
  flex-shrink: 0;
}

.points-btn {
  height: 66rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.func-grid-wrap {
  padding: 0 32rpx 32rpx;
}

.func-grid {
  display: flex;
  flex-wrap: wrap;
  border-radius: 28rpx;
  overflow: hidden;
}

.func-item {
  width: 33.3333%;
  background: #FFFFFF;
  padding: 36rpx 4rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  border: 2rpx solid #F8FAFC;
}

.func-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: #EEF2FF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.func-icon {
  font-size: 36rpx;
}

.func-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
  text-align: center;
}

.func-desc {
  font-size: 22rpx;
  color: #64748B;
  text-align: center;
}

.overview-section {
  padding: 0 32rpx 32rpx;
}

.overview-title {
  font-size: 28rpx;
  color: #4F46E5;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.overview-stats {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  gap: 32rpx;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.overview-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  text-align: center;
}

.overview-label {
  font-size: 22rpx;
  color: #64748B;
  text-align: center;
}

.settings-card {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
  gap: 20rpx;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon-wrap text {
  font-size: 36rpx;
}

.setting-label {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
}

.setting-value {
  font-size: 26rpx;
  color: #94A3B8;
  flex-shrink: 0;
}

.setting-arrow {
  font-size: 32rpx;
  color: #94A3B8;
  flex-shrink: 0;
}

.logout-section {
  margin: 32rpx;
}

.logout-btn {
  width: 100%;
  height: 98rpx;
  background: #FFFFFF;
  border: 2rpx solid #EF4444;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn text {
  font-size: 28rpx;
  color: #EF4444;
}

.bottom-placeholder {
  height: 160rpx;
}