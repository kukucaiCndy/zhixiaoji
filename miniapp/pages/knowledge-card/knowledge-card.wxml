<view class="card-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Nav -->
  <nav-bar title="{{cardTitle || '变量与数据类型'}}"></nav-bar>

  <scroll-view class="card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Progress -->
    <view class="card-progress">
      <text class="cp-text">{{currentIndex || 3}} / {{totalCount || 12}}</text>
      <view class="cp-bar">
        <view class="cp-bar-fill" style="width: {{(currentIndex / totalCount * 100) || 25}}%;"></view>
      </view>
    </view>

    <!-- Card -->
    <view class="card-main">
      <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <view class="card-inner">
        <view class="card-tag">
          <text>{{cardTag || '核心概念'}}</text>
        </view>
        <text class="card-title">{{cardQuestion || 'let 与 const 的区别'}}</text>
        <text class="card-desc">{{cardDescription || '在 JavaScript 中，let 和 const 都是 ES6 引入的块级作用域变量声明方式。let 允许重新赋值，而 const 声明的变量不能重新赋值（但如果是对象或数组，其内容可以修改）。'}}</text>
        <view class="card-code">
          <text>{{cardCode || 'let count = 0;\ncount = 1; // OK\n\nconst PI = 3.14;\nPI = 3.15; // Error!'}}</text>
        </view>
        <text class="card-hint">👈 向左滑动查看详细解析</text>
      </view>
    </view>

    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- Bottom Navigation -->
  <view class="card-bottom">
    <view class="cb-btn cb-btn--prev" bindtap="onPrevCard">
      <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
    </view>
    <view class="cb-btn cb-btn--next" bindtap="onNextCard">
      <text>下一个知识点</text>
    </view>
  </view>
</view>
