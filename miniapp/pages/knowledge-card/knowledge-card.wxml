<web-view wx:if="{{url}}" src="{{url}}" bindmessage="onMessage">

  <!-- 顶部课程圆点 -->
  <cover-view style="position:fixed; top:{{statusBarHeight}}px; left:0; width:100%; height:64rpx; display:flex; align-items:center; justify-content:center; z-index:9999;">
    <cover-view wx:for="{{lessonDots}}" wx:key="*this" wx:for-index="idx"
      style="width:{{idx === currentLesson ? '48rpx' : '16rpx'}}; height:16rpx; border-radius:8rpx; background:{{idx < currentLesson ? '#4F46E5' : idx === currentLesson ? '#4F46E5' : '#E2E8F0'}}; margin:0 6rpx;">
    </cover-view>
  </cover-view>

  <!-- 底部操作栏 -->
  <cover-view style="position:fixed; bottom:0; left:0; right:0; height:128rpx; background:rgba(255,255,255,0.97); display:flex; align-items:center; padding:0 32rpx 40rpx; z-index:9999; box-shadow:0 -2px 8px rgba(0,0,0,0.1);">
    <cover-view bindtap="onPrevLesson"
      style="width:96rpx; height:96rpx; border-radius:48rpx; border:2rpx solid #E2E8F0; background:#FFFFFF; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:12rpx;">
      <cover-view style="font-size:36rpx; color:#64748B;">‹</cover-view>
    </cover-view>
    <cover-view bindtap="onUnderstood"
      style="flex:1; height:96rpx; border-radius:48rpx; background:#4F46E5; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:12rpx;">
      <cover-view style="font-size:28rpx; font-weight:700; color:#FFFFFF;">✅ 理解了</cover-view>
    </cover-view>
    <cover-view bindtap="onHard"
      style="flex:1; height:96rpx; border-radius:48rpx; background:#FFFFFF; border:2rpx solid #F59E0B; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:12rpx;">
      <cover-view style="font-size:28rpx; font-weight:700; color:#F59E0B;">🤔 有点难</cover-view>
    </cover-view>
    <cover-view bindtap="onNote"
      style="flex:1; height:96rpx; border-radius:48rpx; background:#FFFFFF; border:2rpx solid #4F46E5; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:12rpx;">
      <cover-view style="font-size:28rpx; font-weight:700; color:#4F46E5;">📝 记笔记</cover-view>
    </cover-view>
    <cover-view bindtap="onNextLesson"
      style="width:96rpx; height:96rpx; border-radius:48rpx; border:2rpx solid #E2E8F0; background:#FFFFFF; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
      <cover-view style="font-size:36rpx; color:#64748B;">›</cover-view>
    </cover-view>
  </cover-view>

</web-view>
