<web-view wx:if="{{url}}" src="{{url}}" bindmessage="onMessage">
  <cover-view class="section-dots" style="position:fixed; top:{{statusBarHeight}}px;">
    <cover-view wx:for="{{sectionDots}}" wx:key="*this" wx:for-index="idx"
      class="section-dot {{idx === currentSection ? 'active' : idx < currentSection ? 'done' : ''}}">
    </cover-view>
  </cover-view>
  <cover-view class="action-bar" style="position:fixed; bottom:0;">
    <cover-view class="action-nav" bindtap="onPrevCard">
      <cover-view class="nav-text">‹</cover-view>
    </cover-view>
    <cover-view class="action-btn understood" bindtap="onUnderstood">
      <cover-view class="btn-text">✅ 理解了</cover-view>
    </cover-view>
    <cover-view class="action-btn hard" bindtap="onHard">
      <cover-view class="btn-text">🤔 有点难</cover-view>
    </cover-view>
    <cover-view class="action-btn note" bindtap="onNote">
      <cover-view class="btn-text">📝 记笔记</cover-view>
    </cover-view>
    <cover-view class="action-nav" bindtap="onNextCard">
      <cover-view class="nav-text">›</cover-view>
    </cover-view>
  </cover-view>
</web-view>
