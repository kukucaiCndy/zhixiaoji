.page {
  width: 100%;
  height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  box-sizing: border-box;
}

.status-bar {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.time-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.status-icons {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
}

.signal-bar {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1E293B;
}

.nav-bar {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
  flex-shrink: 0;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-arrow {
  font-size: 36rpx;
  color: #64748B;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
}

.nav-favorite {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-icon {
  font-size: 40rpx;
  color: #EF4444;
}

.nav-border {
  width: 100%;
  height: 2rpx;
  background: #E2E8F0;
  flex-shrink: 0;
}

.scroll-content {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
}

.scroll-inner {
  padding: 0;
}

.card-header {
  width: 100%;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.section-dots {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.section-dot-item {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E2E8F0;
  flex-shrink: 0;
}

.section-dot-item.done {
  background: #4F46E5;
}

.section-dot-item.active {
  width: 48rpx;
  background: #4F46E5;
}

.header-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.meta-tag {
  height: 44rpx;
  border-radius: 20rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.meta-tag difficulty {
  background: #FFFBE7;
}

.meta-tag difficulty text {
  font-size: 24rpx;
  color: #F59E0B;
}

.meta-tag time {
  background: #F0FDF4;
}

.meta-tag time text {
  font-size: 24rpx;
  color: #10B981;
}

.meta-tag category {
  background: #EEF2FF;
}

.meta-tag category text {
  font-size: 24rpx;
  color: #4F46E5;
}

.card-front {
  width: 100%;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.cf-inner {
  width: 100%;
  min-height: 720rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx 32rpx;
}

.cf-type {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.cf-type-icon {
  font-size: 28rpx;
}

.cf-type-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #4F46E5;
}

.cf-question {
  margin-bottom: 24rpx;
}

.cf-question text {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 60rpx;
  color: #1E293B;
}

.cf-hint {
  margin-bottom: 40rpx;
  padding: 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
}

.cf-hint text {
  font-size: 28rpx;
  color: #64748B;
  line-height: 44rpx;
}

.cf-flip-hint {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
}

.cf-flip-text {
  font-size: 28rpx;
  color: #4F46E5;
}

.cf-flip-arrow {
  font-size: 32rpx;
  color: #4F46E5;
}

.card-back {
  width: 100%;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.cb-inner {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx 48rpx;
}

.cb-section {
  margin-bottom: 40rpx;
}

.cb-section:last-child {
  margin-bottom: 0;
}

.cb-section-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.cb-s-icon {
  width: 40rpx;
  height: 40rpx;
  background: #EEF2FF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.cb-s-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.cb-section-body {
  padding-left: 56rpx;
}

.cb-body-text {
  font-size: 28rpx;
  color: #475569;
  line-height: 48rpx;
}

.cb-highlight {
  color: #4F46E5;
  font-weight: 700;
}

.cb-code-block {
  margin-left: 56rpx;
  padding: 24rpx;
  background: #1E293B;
  border-radius: 16rpx;
}

.cb-code-block text {
  font-size: 26rpx;
  color: #94A3B8;
  font-family: monospace;
  line-height: 42rpx;
}

.cb-summary-box {
  margin-left: 56rpx;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 32rpx;
}

.cb-summary-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.cb-summary-item:last-child {
  margin-bottom: 0;
}

.cb-dot {
  font-size: 24rpx;
  color: #4F46E5;
  line-height: 42rpx;
}

.cb-item-text {
  font-size: 24rpx;
  color: #1E293B;
  line-height: 42rpx;
  flex: 1;
}

.action-bar {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 80rpx;
}

.action-nav {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-text {
  font-size: 36rpx;
  color: #64748B;
}

.action-btn {
  flex: 1;
  height: 128rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-btn text {
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.action-btn.understood {
  background: #4F46E5;
}

.action-btn.understood text {
  color: #FFFFFF;
}

.action-btn.hard {
  background: #FFFFFF;
  border: 2rpx solid #F59E0B;
}

.action-btn.hard text {
  color: #F59E0B;
}

.action-btn.note {
  background: #FFFFFF;
  border: 2rpx solid #4F46E5;
}

.action-btn.note text {
  color: #4F46E5;
}

.extend-section {
  margin: 0 32rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
}

.extend-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  margin-bottom: 24rpx;
}

.extend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.extend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  height: 78rpx;
  padding: 0 24rpx;
  background: #F8FAFC;
  border-radius: 20rpx;
}

.extend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #4F46E5;
  flex-shrink: 0;
}

.extend-name {
  flex: 1;
  font-size: 26rpx;
  color: #1E293B;
}

.extend-tag {
  height: 38rpx;
  padding: 0 16rpx;
  background: #EEF2FF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.extend-tag text {
  font-size: 22rpx;
  color: #4F46E5;
}

.bottom-placeholder {
  height: 60rpx;
}
