<web-view src="{{url}}">

  <!-- 测试1: 带背景色的顶部固定条（检验 cover-view 基础渲染） -->
  <cover-view style="position:fixed; top:0; left:0; width:100%; height:80rpx; background:rgba(79,70,229,0.9); z-index:9999;">
    <cover-view style="display:flex; align-items:center; justify-content:center; height:80rpx; color:#fff; font-size:28rpx; font-weight:700;">
      顶部固定条 - 基础渲染测试
    </cover-view>
  </cover-view>

  <!-- 测试2: 文字浮层 -->
  <cover-view style="position:fixed; top:100rpx; right:20rpx; padding:12rpx 24rpx; background:rgba(255,255,255,0.95); border-radius:12rpx; font-size:26rpx; color:#333; z-index:9999; box-shadow:0 2px 8px rgba(0,0,0,0.2);">
    cover-view 文字浮层
  </cover-view>

  <!-- 测试3: 底部按钮栏 - cover-view + bindtap（检验 cover-view 嵌套点击） -->
  <cover-view wx:if="{{show}}" style="position:fixed; bottom:0; left:0; right:0; height:100rpx; background:rgba(255,255,255,0.97); display:flex; align-items:center; justify-content:space-evenly; padding:0 20rpx; z-index:9999; box-shadow:0 -2px 8px rgba(0,0,0,0.1);">
    <cover-view
      style="width:180rpx; height:72rpx; background:#4F46E5; border-radius:36rpx; display:flex; align-items:center; justify-content:center; color:#FFF; font-size:28rpx; font-weight:700;"
      bindtap="onCvTap1">
      理解了
    </cover-view>
    <cover-view
      style="width:180rpx; height:72rpx; background:#FFF; border:2rpx solid #F59E0B; border-radius:36rpx; display:flex; align-items:center; justify-content:center; color:#F59E0B; font-size:28rpx; font-weight:700;"
      bindtap="onCvTap2">
      有点难
    </cover-view>
    <!-- 测试4: 用 button 代替 cover-view 点击 -->
    <button
      style="width:180rpx; height:72rpx; background:#FFF; border:2rpx solid #4F46E5; border-radius:36rpx; display:flex; align-items:center; justify-content:center; color:#4F46E5; font-size:28rpx; font-weight:700; line-height:72rpx; padding:0;"
      bindtap="onBtnTap">
      记笔记
    </button>
  </cover-view>

  <!-- 测试5: 半透明遮罩 + 居中弹窗 -->
  <cover-view wx:if="{{show}}" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; z-index:10000;">
    <cover-view style="width:560rpx; height:320rpx; background:#FFF; border-radius:24rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;">
      <cover-view style="font-size:36rpx; font-weight:700; color:#333; margin-bottom:24rpx;">提示</cover-view>
      <cover-view style="font-size:28rpx; color:#666; text-align:center; padding:0 40rpx; margin-bottom:32rpx;">cover-view 弹窗测试<br/>「模拟器可能不显示样式，真机查看」</cover-view>
      <cover-view
        style="width:360rpx; height:72rpx; background:#4F46E5; border-radius:36rpx; display:flex; align-items:center; justify-content:center; color:#FFF; font-size:28rpx; font-weight:700;"
        bindtap="onCvTap1">
        知道了
      </cover-view>
    </cover-view>
  </cover-view>

</web-view>
