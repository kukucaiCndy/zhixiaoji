.splash-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #2D3E5F;
  overflow: hidden;
}

/* ===== 装饰 ===== */
.deco {
  position: absolute;
  z-index: 1;
  pointer-events: none;
}

.deco-1 { top: 400rpx; left: 100rpx; width: 16rpx; height: 16rpx; }
.deco-2 { top: 1000rpx; right: 120rpx; width: 24rpx; height: 24rpx; }
.deco-3 { top: 1400rpx; left: 160rpx; width: 12rpx; height: 12rpx; }

/* ===== Logo ===== */
.logo-container {
  position: absolute;
  left: 274rpx;
  top: 560rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.125);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  width: 96rpx;
  height: 96rpx;
}

/* ===== 标题 ===== */
.title {
  position: absolute;
  left: 274rpx;
  top: 794rpx;
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.tagline {
  position: absolute;
  left: 254rpx;
  top: 888rpx;
  width: 400rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: normal;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
}

/* ===== 加载进度条 ===== */
.loader-bar {
  position: absolute;
  left: 274rpx;
  top: 1200rpx;
  width: 200rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.125);
  overflow: hidden;
}

.loader-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--color-accent);
  transition: width 0.3s ease;
}
