.splash-page {
  width: 100vw;
  height: 100vh;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 跳过按钮 */
.skip-btn {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 40rpx;
  z-index: 10;
}

.skip-btn text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}

/* 广告内容 */
.ad-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
}

.ad-image {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.phone-icon {
  font-size: 120rpx;
  line-height: 1;
}

.ad-title-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sparkle {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.ad-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.ad-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.4;
  margin-bottom: 80rpx;
}

.ad-btn {
  width: 560rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB347 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ad-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

/* 底部广告标识 */
.ad-footer {
  padding-bottom: 60rpx;
  display: flex;
  justify-content: center;
}

.ad-footer text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  line-height: 1.4;
}
