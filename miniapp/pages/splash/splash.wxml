<view class="splash-page" data-theme="{{theme}}">
  <!-- 装饰元素 -->
  <image class="deco deco-1" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-2" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-3" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />

  <!-- Logo -->
  <view class="logo-container">
    <image class="logo-icon" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  </view>

  <!-- 标题 -->
  <text class="title">知小记</text>
  <text class="tagline">让知识学习更轻松</text>

  <!-- 加载进度条 -->
  <view class="loader-bar">
    <view class="loader-fill" style="width: {{loadProgress}}%;"></view>
  </view>
</view>
