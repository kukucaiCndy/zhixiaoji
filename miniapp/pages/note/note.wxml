<view class="note-page">
  <view class="header-section">
    <view class="nav-bar">
      <text class="nav-title">笔记</text>
      <view class="write-btn" bindtap="onAddNote">
        <text>✏️ 写笔记</text>
      </view>
    </view>
  </view>
  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">
      <view class="search-section">
        <view class="search-box">
          <text class="search-icon">🔍</text>
          <text class="search-placeholder">搜索笔记、标签或知识点...</text>
        </view>
        <text class="filter-btn" bindtap="onFilterToggle">筛选</text>
      </view>

      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-tabs">
          <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilter" data-filter="all">
            <text>全部</text>
          </view>
          <view class="filter-item {{currentFilter === 'system' ? 'active' : ''}}" bindtap="onFilter" data-filter="system">
            <text>系统分类</text>
          </view>
          <view class="filter-item {{currentFilter === 'tag' ? 'active' : ''}}" bindtap="onFilter" data-filter="tag">
            <text>自定义标签</text>
          </view>
          <view class="filter-item {{currentFilter === 'time' ? 'active' : ''}}" bindtap="onFilter" data-filter="time">
            <text>时间归档</text>
          </view>
          <view class="filter-item {{currentFilter === 'audit' ? 'active' : ''}}" bindtap="onFilter" data-filter="audit">
            <text>审核状态</text>
          </view>
        </view>
      </scroll-view>

      <view class="note-card" wx:for="{{notes}}" wx:key="id" bindtap="openNote" data-id="{{item.id}}">
        <view class="card-header">
          <text class="card-title">{{item.title}}</text>
        </view>
        <view class="card-summary">
          <text>{{item.summary}}</text>
        </view>
        <view class="card-footer">
          <view class="card-tags">
            <view class="card-tag card-tag-blue">
              <text>{{item.tag1}}</text>
            </view>
            <view class="card-tag card-tag-gray" wx:if="{{item.tag2}}">
              <text>{{item.tag2}}</text>
            </view>
          </view>
          <view class="card-meta">
            <view class="audit-badge audit-{{item.auditStatus}}">
              <text>{{item.auditText}}</text>
            </view>
            <text class="card-time">{{item.time}}</text>
            <view class="card-source" wx:if="{{item.source}}">
              <text>来自: {{item.source}}</text>
            </view>
            <text class="card-reason" wx:if="{{item.auditStatus === 'failed'}}" bindtap="{{item.reasonTap}}">查看原因</text>
          </view>
        </view>
      </view>
      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <view class="fab-main" bindtap="onAddNote">
    <text>+</text>
  </view>

  <tab-bar activeIndex="2" bind:change="onTabChange"></tab-bar>
</view>