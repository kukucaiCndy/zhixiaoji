.note-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

.header-section {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 0 32rpx 24rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.status-icons {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.signal-bar {
  width: 32rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.8);
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 106rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.write-btn {
  height: 50rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
}

.write-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.search-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
}

.search-box {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-icon {
  font-size: 30rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #94A3B8;
}

.filter-btn {
  font-size: 26rpx;
  color: #4F46E5;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-scroll {
  width: 100%;
  padding-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  gap: 8rpx;
}

.filter-item {
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #E2E8F0;
  background: #FFFFFF;
  flex-shrink: 0;
}

.filter-item text {
  font-size: 26rpx;
  color: #64748B;
  white-space: nowrap;
}

.filter-item.active {
  background: #4F46E5;
  border-color: #4F46E5;
}

.filter-item.active text {
  color: #FFFFFF;
}

.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 24rpx 32rpx;
}

.note-card {
  position: relative;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.card-header {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.card-summary {
  margin-bottom: 20rpx;
}

.card-summary text {
  font-size: 28rpx;
  color: #64748B;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.card-tag {
  height: 38rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.card-tag text {
  font-size: 22rpx;
}

.card-tag-blue {
  background: #EEF2FF;
}
.card-tag-blue text {
  color: #4F46E5;
}

.card-tag-gray {
  background: #F1F5F9;
}
.card-tag-gray text {
  color: #64748B;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.audit-badge {
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.audit-badge text {
  font-size: 20rpx;
  white-space: nowrap;
}

.audit-passed {
  background: #ECFDF5;
}
.audit-passed text {
  color: #10B981;
}

.audit-reviewing {
  background: #FEF3C7;
}
.audit-reviewing text {
  color: #D97706;
}

.audit-failed {
  background: #FEF2F2;
}
.audit-failed text {
  color: #EF4444;
}

.card-time {
  font-size: 24rpx;
  color: #94A3B8;
}

.card-source text {
  font-size: 24rpx;
  color: #4F46E5;
}

.card-reason {
  font-size: 24rpx;
  color: #EF4444;
}

.fab-main {
  position: fixed;
  bottom: 200rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #4F46E5;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-main text {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.bottom-placeholder {
  height: 160rpx;
}