.knowledge-chapters-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 40rpx;
  color: #1E293B;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  flex: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-placeholder {
  width: 80rpx;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

/* 知识章节信息卡片 */
.chapter-info-card {
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
}

.chapter-info-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.chapter-info-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
  display: block;
  line-height: 1.5;
}

.chapter-info-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.info-tag {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.info-tag text {
  font-size: 22rpx;
  color: #FFFFFF;
}

.chapter-info-progress {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.15);
}

.progress-text {
  margin-bottom: 12rpx;
}

.progress-text text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.progress-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.9);
}

/* 学习目标卡片 */
.goal-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goal-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4F46E5;
  display: block;
  margin-bottom: 8rpx;
}

.goal-text {
  font-size: 28rpx;
  color: #1E293B;
  line-height: 1.5;
  display: block;
}

/* 分区标题 */
.section-header {
  display: flex;
  align-items: center;
  height: 66rpx;
  margin-top: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

/* 小节列表 */
.section-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-item.locked {
  opacity: 0.5;
}

.section-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.section-status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.section-status-dot.completed {
  background: #10B981;
}

.section-status-dot.studying {
  background: #4F46E5;
}

.section-status-dot.locked {
  background: #E2E8F0;
}

.section-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-meta {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}

.section-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.section-check {
  font-size: 32rpx;
  color: #10B981;
  font-weight: 700;
}

.section-lock {
  font-size: 28rpx;
}

.section-arrow {
  font-size: 32rpx;
  color: #94A3B8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 底部占位 */
.bottom-placeholder {
  height: 80rpx;
}