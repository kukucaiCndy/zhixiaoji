.kc-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.card-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

/* ===== Scroll ===== */
.kc-scroll { position: relative; z-index: 1; flex: 1; padding: 0 48rpx; }
.bottom-placeholder { height: 80rpx; }

/* ===== Header Card ===== */
.kc-header-card {
  position: relative; margin-top: 24rpx;
  border-radius: 32rpx; overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.kc-hc-inner {
  position: relative; z-index: 1;
  display: flex; align-items: center; padding: 32rpx; gap: 24rpx;
}

.kc-hc-icon {
  width: 112rpx; height: 112rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.kc-hc-icon-img { width: 64rpx; height: 64rpx; }
.kc-hc-emoji { font-size: 64rpx; }

.kc-hc-name {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx; font-weight: 600; color: var(--color-text); display: block;
}

.kc-hc-meta {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx; color: var(--color-text-secondary); display: block; margin-top: 8rpx;
}

/* ===== Breadcrumb ===== */
.kc-breadcrumb {
  display: flex; align-items: center; gap: 8rpx; margin: 24rpx 0;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx; color: var(--color-text-secondary);
}

.kc-bc-icon { width: 28rpx; height: 28rpx; }

/* ===== Chapters ===== */
.kc-chapters { display: flex; flex-direction: column; gap: 24rpx; }

.kc-chapter {
  position: relative; border-radius: 24rpx; overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.kc-chapter--locked { opacity: 0.65; }

.kc-ch-inner { position: relative; z-index: 1; }

.kc-ch-header {
  display: flex; align-items: center; padding: 28rpx 32rpx; gap: 20rpx;
}

.kc-ch-num {
  width: 48rpx; height: 48rpx; border-radius: 24rpx;
  background: var(--color-surface); display: flex; align-items: center; justify-content: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx; font-weight: 700; color: var(--color-primary); flex-shrink: 0;
}

.kc-ch-info { flex: 1; }

.kc-ch-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx; font-weight: 600; color: var(--color-text); display: block;
}

.kc-ch-meta {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx; color: var(--color-text-secondary); display: block; margin-top: 4rpx;
}

.kc-ch-toggle {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 40rpx; color: var(--color-text-secondary); width: 48rpx; text-align: center;
}

.kc-chapter--open .kc-ch-header { border-bottom: 2rpx solid var(--color-divider); }
.kc-chapter--open .kc-ch-toggle { color: var(--color-primary); }

/* ===== Lessons ===== */
.kc-lessons { padding: 0 0 16rpx; }

.kc-lesson {
  display: flex; align-items: center; padding: 24rpx 32rpx 24rpx 80rpx; gap: 20rpx;
}

.kc-lesson--locked { opacity: 0.55; }

.kc-l-num {
  width: 40rpx; height: 40rpx; border-radius: 20rpx;
  background: var(--color-bg); display: flex; align-items: center; justify-content: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx; font-weight: 600; color: var(--color-text-secondary); flex-shrink: 0;
}

.kc-l-title {
  flex: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx; font-weight: 500; color: var(--color-text);
}

.kc-l-arrow {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx; color: var(--color-text-tertiary);
}
