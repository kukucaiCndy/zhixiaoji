.knowledge-chapters-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 导航栏容器（适配刘海屏） */
.nav-container {
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-back {
  width: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 36rpx;
  color: #4F46E5;
  font-weight: 400;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  flex: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-placeholder {
  width: 48rpx;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

/* 知识章节头部卡片 */
.chapter-header-card {
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.ch-header-left {
  margin-right: 28rpx;
  flex-shrink: 0;
}

.ch-header-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-header-icon {
  font-size: 48rpx;
}

.ch-header-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.ch-header-info {
  flex: 1;
  min-width: 0;
}

.ch-header-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ch-header-meta {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 12rpx;
}

.ch-header-progress-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F1F5F9;
  overflow: hidden;
}

.ch-header-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #4F46E5 0%, #06B6D4 100%);
}

.ch-header-progress-text {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4F46E5;
}

/* 面包屑导航 */
.breadcrumb {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.breadcrumb-parent {
  font-size: 24rpx;
  color: #94A3B8;
}

.breadcrumb-current {
  font-size: 24rpx;
  color: #4F46E5;
  font-weight: 500;
}

/* 学习目标卡片 */
.goal-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goal-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4F46E5;
  display: block;
  margin-bottom: 8rpx;
}

.goal-text {
  font-size: 28rpx;
  color: #1E293B;
  line-height: 1.5;
  display: block;
}

/* 小节列表 */
.section-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-item.locked {
  opacity: 0.6;
}

/* 序号圆圈 */
.section-number-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
}

.section-number-wrap.completed {
  background: #D1FAE5;
}

.section-number-wrap.studying {
  background: #EEF2FF;
}

.section-number-wrap.locked {
  background: #F1F5F9;
}

.section-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-info {
  flex: 1;
  min-width: 0;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-meta {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
}

.section-unlock-hint {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #FEF2F2;
}

.unlock-hint-text {
  font-size: 22rpx;
  color: #EF4444;
  line-height: 1.4;
}

/* 状态徽章 */
.section-status-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.section-status-badge.completed {
  background: #D1FAE5;
}

.section-status-badge.studying {
  background: #EEF2FF;
}

.section-status-badge.locked {
  background: #F1F5F9;
}

.status-badge-text {
  font-size: 24rpx;
  font-weight: 500;
}

.section-status-badge.completed .status-badge-text {
  color: #059669;
}

.section-status-badge.studying .status-badge-text {
  color: #4F46E5;
}

.section-status-badge.locked .status-badge-text {
  color: #94A3B8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 底部占位 */
.bottom-placeholder {
  height: 80rpx;
}