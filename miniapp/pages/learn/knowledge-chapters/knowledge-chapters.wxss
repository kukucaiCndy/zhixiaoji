.knowledge-chapters-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-container {
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-back {
  width: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 36rpx;
  color: #4F46E5;
  font-weight: 400;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  flex: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-placeholder {
  width: 48rpx;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

/* ===== 科目头部卡片 ===== */
.subject-header-card {
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.subj-header-left {
  margin-right: 28rpx;
  flex-shrink: 0;
}

.subj-header-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subj-header-icon {
  font-size: 48rpx;
}

.subj-header-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.subj-header-info {
  flex: 1;
  min-width: 0;
}

.subj-header-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subj-header-meta {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
}

/* 面包屑导航 */
.breadcrumb {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.breadcrumb-parent {
  font-size: 24rpx;
  color: #94A3B8;
}

.breadcrumb-current {
  font-size: 24rpx;
  color: #4F46E5;
  font-weight: 500;
}

/* ===== 可折叠章节列表 ===== */
.chapter-collapse-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.chapter-collapse-item {
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  position: relative;
}

/* 锁定状态 */
.chapter-collapse-item.locked {
  opacity: 0.65;
  background: #F8FAFC;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

/* 进度背景条 */
.chapter-progress-bg {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, rgba(79, 70, 229, 0.06) 0%, rgba(6, 182, 212, 0.04) 100%);
  pointer-events: none;
  z-index: 0;
}

/* 章节标题头（点击区域） */
.chapter-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  position: relative;
  z-index: 1;
}

.chapter-header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.chapter-index-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #EEF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #4F46E5;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.chapter-index-badge.locked {
  background: #F1F5F9;
  color: #94A3B8;
}

.chapter-header-text {
  flex: 1;
  min-width: 0;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-meta {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-top: 4rpx;
}

.chapter-header-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.chapter-toggle {
  font-size: 36rpx;
  color: #94A3B8;
  font-weight: 300;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chapter-toggle.locked {
  font-size: 28rpx;
  color: #CBD5E1;
}

/* 展开状态 */
.chapter-collapse-item.expanded {
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.10);
}

.chapter-collapse-item.expanded .chapter-header {
  border-bottom: 2rpx solid #F1F5F9;
}

.chapter-collapse-item.expanded .chapter-toggle {
  color: #4F46E5;
}

/* ===== 课程列表 ===== */
.lesson-list {
  padding: 0 0 8rpx;
  position: relative;
  z-index: 1;
}

.lesson-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx 24rpx 40rpx;
  border-bottom: 2rpx solid #F8FAFC;
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-item.locked {
  opacity: 0.55;
}

.lesson-number-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.lesson-number-wrap.locked {
  background: #F8FAFC;
}

.lesson-number {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
}

.lesson-info {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-meta {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-top: 4rpx;
}

.lesson-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.lesson-loading,
.lesson-empty {
  padding: 32rpx 0;
  text-align: center;
}

.lesson-loading-text,
.lesson-empty-text {
  font-size: 26rpx;
  color: #94A3B8;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 底部占位 */
.bottom-placeholder {
  height: 80rpx;
}
