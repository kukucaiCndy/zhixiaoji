<view class="kc-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Nav -->
  <nav-bar title="{{subjectTitle}}"></nav-bar>

  <scroll-view class="kc-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Header Card -->
    <view class="kc-header-card">
      <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <view class="kc-hc-inner">
        <view class="kc-hc-icon" style="background-color: {{subjectIconBg}};">
          <image wx:if="{{subjectIconType === 'image'}}" class="kc-hc-icon-img" src="{{subjectIcon}}" mode="aspectFit" />
          <text wx:else class="kc-hc-emoji">{{subjectIcon}}</text>
        </view>
        <view class="kc-hc-info">
          <text class="kc-hc-name">{{subjectTitle}}</text>
          <text class="kc-hc-meta">{{chapterCount}}章节 · {{categoryName}}分类</text>
        </view>
      </view>
    </view>

    <!-- Breadcrumb -->
    <view class="kc-breadcrumb">
      <image class="kc-bc-icon" src="/assets/images/{{theme}}/deco/deco_check.png" mode="aspectFit" />
      <text>{{categoryName}}  >  {{subjectTitle}}</text>
    </view>

    <!-- Chapters -->
    <view class="kc-chapters">
      <view class="kc-chapter {{item.expanded ? 'kc-chapter--open' : ''}} {{item.locked ? 'kc-chapter--locked' : ''}}" wx:for="{{chapters}}" wx:key="id">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
        <view class="kc-ch-inner">
          <view class="kc-ch-header" bindtap="onChapterTap" data-index="{{index}}">
            <view class="kc-ch-num">{{index + 1}}</view>
            <view class="kc-ch-info">
              <text class="kc-ch-title">{{item.title}}</text>
              <text class="kc-ch-meta" wx:if="{{item.locked}}">完成上一章后解锁</text>
              <text class="kc-ch-meta" wx:else>{{item.lessonCount || 0}} 节</text>
            </view>
            <text class="kc-ch-toggle">{{item.expanded ? '−' : '+'}}</text>
          </view>

          <!-- Lessons -->
          <view class="kc-lessons" wx:if="{{item.expanded}}">
            <view class="kc-lesson {{lesson.locked ? 'kc-lesson--locked' : ''}}" wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="id" bindtap="onLessonTap" data-chapter-index="{{index}}" data-lesson-id="{{lesson.id}}">
              <text class="kc-l-num">{{lesson.number || (lessonIdx + 1)}}</text>
              <text class="kc-l-title">{{lesson.title}}</text>
              <text class="kc-l-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
