<view class="knowledge-chapters-page">
  <!-- 导航栏（适配刘海屏） -->
  <view class="nav-container" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="nav-title">{{subjectTitle}}</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">
      <!-- 科目头部卡片 -->
      <view class="chapter-header-card">
        <view class="ch-header-left">
          <view class="ch-header-icon-wrap" style="background-color: {{subjectIconBg}};">
            <image wx:if="{{subjectIconType === 'image'}}" class="ch-header-icon ch-header-icon-img" src="{{subjectIcon}}" mode="aspectFit" />
            <text wx:else class="ch-header-icon">{{subjectIcon}}</text>
          </view>
        </view>
        <view class="ch-header-info">
          <text class="ch-header-name">{{subjectTitle}}</text>
          <text class="ch-header-meta">{{chapterCount}}章节 · {{categoryName}}分类</text>
        </view>
      </view>

      <!-- 面包屑导航 -->
      <view class="breadcrumb">
        <text class="breadcrumb-parent">{{categoryName}} ></text>
        <text class="breadcrumb-current">{{subjectTitle}}</text>
      </view>

      <!-- 章节列表 -->
      <view class="section-list">
        <view class="section-item" wx:for="{{chapters}}" wx:key="id" bindtap="onChapterTap" data-chapter="{{item}}" data-index="{{index}}">
          <view class="section-number-wrap">
            <text class="section-number">{{index + 1}}</text>
          </view>
          <view class="section-info">
            <text class="section-title-text">{{item.title}}</text>
            <text class="section-meta" wx:if="{{item.unlockPoints > 0}}">需 {{item.unlockPoints}} 积分解锁</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{chapters.length === 0 && !loading}}">
          <text class="empty-icon">📭</text>
          <text class="empty-text">暂无章节内容</text>
        </view>

        <!-- 加载中 -->
        <view class="loading-state" wx:if="{{loading}}">
          <text class="loading-text">加载中...</text>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>
</view>