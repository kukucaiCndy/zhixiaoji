.learn-page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.scroll-content {
  flex: 1;
  position: relative;
  z-index: 1;
}

.scroll-inner {
  position: relative;
  padding: 0 48rpx;
}

.bottom-placeholder { height: 168rpx; }

/* ===== Header ===== */
.header {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 192rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 54rpx 48rpx 0;
  box-sizing: border-box;
}

.title {
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
}

.subtitle {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}

/* ===== Weekly Card ===== */
.weekly-card {
  position: relative;
  width: 100%;
  height: 320rpx;
  margin-top: 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.weekly-inner {
  position: relative;
  z-index: 1;
  padding: 36rpx 40rpx;
  height: 100%;
  box-sizing: border-box;
}

.weekly-title {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 40rpx;
}

.week-days {
  display: flex;
  justify-content: space-between;
}

.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 64rpx;
}

.day-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-divider);
}

.day-dot--active { background: var(--color-primary); }
.day-dot--today { background: var(--color-accent); }

.day-label {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ===== Section Title ===== */
.section-title {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

/* ===== Course Card ===== */
.course-card {
  position: relative;
  width: 100%;
  height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.course-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 100%;
  box-sizing: border-box;
}

.course-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 课程图标背景色（原内联 style 改为类名，支持主题切换）*/
.course-icon--0 { background: var(--color-surface); }
.course-icon--1 { background: var(--color-accent-light); }
.course-icon--2 { background: var(--color-divider); }
.course-icon--3 { background: var(--color-success); opacity: 0.15; }
.course-icon--4 { background: var(--color-warning); opacity: 0.15; }

.course-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.course-info {
  flex: 1;
  margin-left: 24rpx;
}

.course-name {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.course-progress {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.course-percent {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary-light);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== Browse Card ===== */
.browse-card {
  position: relative;
  width: 100%;
  height: 144rpx;
  margin-top: 56rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.browse-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 100%;
  box-sizing: border-box;
}

.browse-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.browse-icon image {
  width: 48rpx;
  height: 48rpx;
}

.browse-info {
  flex: 1;
  margin-left: 24rpx;
}

.browse-title {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.browse-desc {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.browse-arrow {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 40rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* ===== 装饰 ===== */
.deco {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

.deco-wave   { top: 120rpx; right: 30rpx; width: 40rpx; height: 12rpx; }
.deco-circle { top: 400rpx; left: 80rpx; width: 16rpx; height: 16rpx; }
.deco-star   { top: 440rpx; right: 70rpx; width: 20rpx; height: 20rpx; }
.deco-dot    { top: 1188rpx; left: 120rpx; width: 10rpx; height: 10rpx; }
