.learn-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

.header-section {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 0 32rpx 24rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.status-icons {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.signal-bar {
  width: 32rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.8);
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 106rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.search-btn {
  height: 50rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
}

.search-btn text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

.path-tabs {
  display: flex;
  height: 96rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  overflow-x: auto;
}

.path-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  position: relative;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.path-tab text {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 400;
  white-space: nowrap;
}

.path-tab.active text {
  color: #4F46E5;
  font-weight: 700;
}

.active-indicator {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
}

.path-tab.active .active-indicator {
  background: #4F46E5;
}

.continue-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.continue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.continue-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.continue-more {
  font-size: 24rpx;
  color: #4F46E5;
}

.continue-body {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F8FAFC;
  align-items: center;
}

.continue-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4F46E5, #818CF8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.continue-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.continue-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.continue-desc {
  font-size: 24rpx;
  color: #64748B;
}

.feature-grid {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.feature-item {
  flex: 1;
  min-width: 0;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.feature-icon.purple { background: #EEF2FF; }
.feature-icon.red { background: #FEF2F2; }
.feature-icon.green { background: #ECFDF5; }
.feature-icon.orange { background: #FFF7ED; }

.feature-label {
  font-size: 22rpx;
  color: #64748B;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 84rpx;
  padding: 24rpx 0 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-more {
  font-size: 24rpx;
  color: #4F46E5;
}

.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.knowledge-item {
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.knowledge-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}

.knowledge-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.knowledge-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #EEF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.knowledge-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.knowledge-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.knowledge-progress {
  font-size: 24rpx;
  color: #64748B;
}

.knowledge-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.knowledge-tag {
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.knowledge-tag text {
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.knowledge-tag-studying {
  background: #EEF2FF;
}
.knowledge-tag-studying text {
  color: #4F46E5;
}

.knowledge-tag-completed {
  background: #ECFDF5;
}
.knowledge-tag-completed text {
  color: #10B981;
}

.knowledge-tag-locking {
  background: #F1F5F9;
}
.knowledge-tag-locking text {
  color: #94A3B8;
}

.knowledge-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #4F46E5;
  min-width: 40rpx;
  text-align: right;
}

.knowledge-arrow {
  font-size: 24rpx;
  color: #94A3B8;
  transition: transform 0.2s;
}

.knowledge-arrow.expanded {
  transform: rotate(180deg);
}

.knowledge-sub {
  display: none;
  border-top: 2rpx solid #F1F5F9;
}

.knowledge-sub.show {
  display: block;
}

.sub-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 20rpx 104rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.sub-item:last-child {
  border-bottom: none;
}

.sub-name {
  flex: 1;
  font-size: 26rpx;
  color: #1E293B;
}

.sub-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sub-badge text {
  font-size: 18rpx;
  font-weight: 700;
}

.sub-badge-done {
  background: #10B981;
}
.sub-badge-done text {
  color: #FFFFFF;
}

.sub-badge-progress {
  background: #4F46E5;
}
.sub-badge-progress text {
  color: #FFFFFF;
}

.sub-badge-locked {
  background: #E2E8F0;
}
.sub-badge-locked text {
  color: #94A3B8;
  font-size: 16rpx;
}

.bottom-placeholder {
  height: 160rpx;
}