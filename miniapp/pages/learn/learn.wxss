.learn-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1E293B;
}

/* 搜索栏 */
.search-section {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: #F1F5F9;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.4;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #94A3B8;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

/* 用户信息卡片 */
.profile-banner {
  margin-top: 32rpx;
  padding: 40rpx 40rpx 0 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4F46E5, #06B6D4);
}

.profile-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile-left {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-avatar text {
  font-size: 48rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.profile-level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.profile-streak {
  display: flex;
  align-items: center;
}

.streak-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.streak-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* 统计数据行 */
.profile-stats {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  margin-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.15);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* 分区标题 */
.section-header {
  display: flex;
  align-items: center;
  height: 66rpx;
  margin-top: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.category-card {
  width: 331rpx;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.category-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.category-icon {
  font-size: 56rpx;
}

.category-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.category-desc {
  font-size: 24rpx;
  color: #94A3B8;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.4;
  min-height: 34rpx;
}

.category-progress-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F1F5F9;
  overflow: hidden;
}

.category-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #4F46E5, #06B6D4);
}

/* 继续学习卡片 */
.continue-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.continue-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #EEF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.continue-icon {
  font-size: 44rpx;
}

.continue-info {
  flex: 1;
  min-width: 0;
}

.continue-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-desc {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.continue-arrow {
  font-size: 32rpx;
  color: #1E293B;
  opacity: 0.3;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 160rpx;
}