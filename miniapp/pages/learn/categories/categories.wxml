<view class="cat-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- 装饰元素 -->
  <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
  <image class="deco deco-dot" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />
  <image class="deco deco-wave" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />

  <!-- 导航栏 -->
  <nav-bar title="全部内容"></nav-bar>

  <!-- 搜索 Hero -->
  <view class="search-hero">
    <image class="search-hero-bg" src="/assets/images/{{theme}}/bg/bg_hero_card.png" mode="aspectFill" />
    <view class="search-hero-inner">
      <text class="search-hero-title">探索知识库</text>
      <view class="search-box">
        <text class="search-box-icon">🔍</text>
        <text class="search-box-hint">搜索知识内容...</text>
      </view>
    </view>
  </view>

  <!-- 分类区域标题 -->
  <view class="section-header">
    <text class="section-title">知识分类</text>
    <text class="section-count">{{chapters.length}} 个分类</text>
  </view>

  <!-- 分类卡片网格 -->
  <scroll-view class="cat-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="cat-grid">
      <view class="cat-card" wx:for="{{chapters}}" wx:key="id" bindtap="onChapterTap" data-chapter="{{item}}">
        <view class="cat-card-icon" style="background-color: {{item.iconBg}};">
          <image wx:if="{{item.iconType === 'image'}}" class="cat-card-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else class="cat-card-icon-emoji">{{item.icon}}</text>
        </view>
        <text class="cat-card-name">{{item.title}}</text>
        <text class="cat-card-meta">{{item.knowledgeCount || item.sectionCount || 0}} 个知识点</text>
      </view>
    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
