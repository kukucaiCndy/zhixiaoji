.cat-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ===== 装饰元素 ===== */
.deco {
  position: absolute;
  z-index: 5;
  pointer-events: none;
}
.deco-star { top: 150rpx; right: 56rpx; width: 24rpx; height: 24rpx; }
.deco-dot  { top: 1020rpx; left: 60rpx; width: 10rpx; height: 10rpx; }
.deco-wave { top: 800rpx; right: 56rpx; width: 36rpx; height: 12rpx; }

/* ===== 搜索 Hero ===== */
.search-hero {
  position: relative;
  z-index: 1;
  margin: 32rpx 48rpx 0;
  height: 176rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.search-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.search-hero-inner {
  position: relative;
  z-index: 1;
  padding: 28rpx 40rpx;
}

.search-hero-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.search-box {
  margin-top: 24rpx;
  width: 574rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.search-box-icon {
  font-size: 28rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.search-box-hint {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 16rpx;
}

/* ===== 分类区域标题 ===== */
.section-header {
  position: relative;
  z-index: 1;
  margin: 36rpx 48rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-count {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 滚动区域 ===== */
.cat-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 0 48rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.bottom-placeholder {
  height: 40rpx;
}

/* ===== 分类卡片 ===== */
.cat-card {
  width: 314rpx;
  height: 240rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 0;
  box-sizing: border-box;
}

.cat-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cat-card-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.cat-card-icon-emoji {
  font-size: 40rpx;
  line-height: 1;
  color: #FFFFFF;
}

.cat-card-name {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 24rpx;
}

.cat-card-meta {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}
