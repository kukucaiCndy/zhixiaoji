<view class="learn-page">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">学习</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-bar" bindtap="onSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索知识卡片</text>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">
      <!-- 用户信息卡片 -->
      <view class="profile-banner">
        <view class="profile-top">
          <view class="profile-left">
            <view class="profile-avatar">
              <text>😊</text>
            </view>
            <view class="profile-info">
              <text class="profile-name">{{userName}}</text>
              <text class="profile-level">{{userLevel}}</text>
            </view>
          </view>
          <view class="profile-streak">
            <text class="streak-icon">🔥</text>
            <text class="streak-text">{{streakDays}}天</text>
          </view>
        </view>
        <view class="profile-stats">
          <view class="stat-item">
            <text class="stat-value">{{learnedCards}}</text>
            <text class="stat-label">已学卡片</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{accuracy}}%</text>
            <text class="stat-label">正确率</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{points}}</text>
            <text class="stat-label">积分</text>
          </view>
        </view>
      </view>

      <!-- 知识分类 -->
      <view class="section-header">
        <text class="section-title">知识分类</text>
      </view>

      <view class="category-grid">
        <view class="category-card" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-category="{{item}}">
          <view class="category-icon-wrap" style="background-color: {{item.bgColor}};">
            <image wx:if="{{item.iconType === 'image'}}" class="category-icon category-icon-img" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else class="category-icon">{{item.icon}}</text>
          </view>
          <text class="category-name">{{item.name}}</text>
          <text class="category-desc">{{item.description}}</text>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <tab-bar activeIndex="1" bind:change="onTabChange"></tab-bar>
</view>