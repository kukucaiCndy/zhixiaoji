<view class="learn-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Header -->
  <view class="header">
    <image class="header-bg" src="/assets/images/{{theme}}/bg/bg_navbar.png" mode="aspectFill" />
    <view class="header-content">
      <text class="title">学习</text>
      <text class="subtitle">保持专注，持续进步</text>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">

      <!-- 装饰 -->
      <image class="deco deco-wave" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />
      <image class="deco deco-circle" src="/assets/images/{{theme}}/deco/deco_circle.png" mode="aspectFit" />
      <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />

      <!-- Weekly Overview -->
      <view class="weekly-card">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
        <view class="weekly-inner">
          <text class="weekly-title">本周学习</text>
          <view class="week-days">
            <view class="day-item" wx:for="{{weekDays}}" wx:key="label">
              <view class="day-dot {{item.active ? 'day-dot--active' : ''}} {{item.today ? 'day-dot--today' : ''}}"></view>
              <text class="day-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Section Title -->
      <text class="section-title">正在学习</text>

      <!-- Course Cards -->
      <view class="course-card" wx:for="{{courses}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}" data-name="{{item.name}}">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
        <view class="course-inner">
          <view class="course-icon course-icon--{{item.iconBg}}">
            <image class="course-icon-img" src="/assets/images/{{theme}}/deco/deco_check.png" mode="aspectFit" />
          </view>
          <view class="course-info">
            <text class="course-name">{{item.name}}</text>
            <text class="course-progress">第 {{item.currentChapter}} 章 / 共 {{item.totalChapters}} 章</text>
          </view>
          <text class="course-percent">{{item.percent}}%</text>
        </view>
      </view>

      <!-- Browse All Card -->
      <view class="browse-card" bindtap="onBrowseAll">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
        <view class="browse-inner">
          <view class="browse-icon">
            <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
          </view>
          <view class="browse-info">
            <text class="browse-title">浏览全部内容</text>
            <text class="browse-desc">查看所有知识分类</text>
          </view>
          <text class="browse-arrow">›</text>
        </view>
      </view>

      <image class="deco deco-dot" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />
      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <tab-bar activeIndex="1" bind:change="onTabChange"></tab-bar>
</view>
