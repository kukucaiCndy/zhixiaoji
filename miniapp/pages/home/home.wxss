.home-page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

.header-section {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 0 32rpx 24rpx;
  padding-top: 0;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: "Microsoft YaHei";
}

.status-icons {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.signal-bar {
  width: 32rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.8);
}

.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 106rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: "Microsoft YaHei";
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.15);
}

.search-btn text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: "Microsoft YaHei";
}

.user-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 160rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4F46E5, #06B6D4);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 48rpx;
}

.avatar-letter {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: "Microsoft YaHei";
}

.user-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  font-family: "Microsoft YaHei";
}

.streak-text {
  font-size: 24rpx;
  color: #64748B;
  font-family: "Microsoft YaHei";
}

.streak-highlight {
  font-weight: 700;
  color: #F59E0B;
}

.points-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
}

.points-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #92400E;
  font-family: "Microsoft YaHei";
}

.points-label {
  font-size: 22rpx;
  color: #A16107;
  font-family: "Microsoft YaHei";
}

.scroll-content {
  flex: 1;
}

.scroll-inner {
  padding: 0 32rpx;
}

.challenge-card {
  position: relative;
  width: 100%;
  min-height: 280rpx;
  margin-top: 24rpx;
  padding: 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4F46E5, #06B6D4);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.challenge-deco-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.deco-circle.c1 {
  width: 200rpx;
  height: 200rpx;
  right: 20rpx;
  top: 60rpx;
}

.deco-circle.c2 {
  width: 320rpx;
  height: 320rpx;
  right: -40rpx;
  top: -80rpx;
  background: rgba(255, 255, 255, 0.08);
}

.challenge-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: "Microsoft YaHei";
  position: relative;
  z-index: 1;
}

.challenge-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-family: "Microsoft YaHei";
  position: relative;
  z-index: 1;
}

.challenge-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  align-self: flex-start;
  position: relative;
  z-index: 1;
}

.challenge-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-family: "Microsoft YaHei";
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 84rpx;
  padding: 24rpx 0 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E293B;
  font-family: "Microsoft YaHei";
}

.section-more {
  font-size: 26rpx;
  color: #4F46E5;
  font-family: "Microsoft YaHei";
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.stat-item {
  width: calc(50% - 12rpx);
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.stat-icon.purple { background: #EEF2FF; }
.stat-icon.green { background: #ECFDF5; }
.stat-icon.orange { background: #FFF7ED; }
.stat-icon.red { background: #FEF2F2; }

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E293B;
  font-family: "Microsoft YaHei";
}

.stat-label {
  font-size: 26rpx;
  color: #64748B;
  font-family: "Microsoft YaHei";
}

.stat-progress {
  margin-top: 8rpx;
}

.progress-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(238, 242, 255, 1);
  overflow: hidden;
}

.progress-track.tall {
  height: 12rpx;
  border-radius: 6rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
}

.progress-fill.tall {
  border-radius: 6rpx;
}

.progress-fill.purple { background: #4F46E5; }
.progress-fill.green { background: #10B981; }
.progress-fill.orange { background: #F59E0B; }
.progress-fill.red { background: #EF4444; }
.progress-fill.cyan { background: #06B6D4; }

.challenge-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 152rpx;
  padding: 0 32rpx;
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  box-sizing: border-box;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #4F46E5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.entry-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  font-family: "Microsoft YaHei";
}

.entry-desc {
  font-size: 24rpx;
  color: #64748B;
  font-family: "Microsoft YaHei";
}

.entry-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4F46E5;
  flex-shrink: 0;
  font-family: "Microsoft YaHei";
}

.progress-list {
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 70rpx;
}

.progress-name {
  width: 130rpx;
  font-size: 28rpx;
  color: #1E293B;
  font-family: "Microsoft YaHei";
  flex-shrink: 0;
}

.progress-bar-wrap {
  flex: 1;
}

.progress-percent {
  width: 72rpx;
  font-size: 24rpx;
  color: #64748B;
  text-align: right;
  font-family: "Microsoft YaHei";
  flex-shrink: 0;
}

.recommend-scroll {
  width: 100%;
  margin-top: 8rpx;
}

.recommend-list {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0 48rpx;
}

.rec-card {
  width: 280rpx;
  min-width: 280rpx;
  height: 296rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.rec-thumb {
  width: 232rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.rec-thumb.purple { background: linear-gradient(135deg, #4F46E5, #818CF8); }
.rec-thumb.cyan { background: linear-gradient(135deg, #06B6D4, #22D3EE); }
.rec-thumb.orange { background: linear-gradient(135deg, #F59E0B, #FBBF24); }

.rec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  font-family: "Microsoft YaHei";
  margin-top: 16rpx;
}

.rec-desc {
  font-size: 22rpx;
  color: #94A3B8;
  font-family: "Microsoft YaHei";
  margin-top: 8rpx;
}

.bottom-placeholder {
  height: 160rpx;
}