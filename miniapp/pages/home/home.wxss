/* ============================================
   知小记 · 主页样式 (Pencil MCP RweGQ 1:1复刻)
   Tokens: accent=#C8B496 primary=#2D3E5F bg=#F4F2EF
   Dimension base: 375px → 750rpx
   ============================================ */

.home-page {
  min-height: 100vh;
  background-color: #F4F2EF;
  display: flex;
  flex-direction: column;
}

.scroll-content {
  flex: 1;
}

.scroll-inner {
  position: relative;
  width: 100%;
}

.bottom-placeholder {
  height: 168rpx;
}

/* ---- Header (96px/192rpx) ---- */
.header {
  position: relative;
  width: 100%;
  height: 192rpx;
  padding: 104rpx 48rpx 0;
  background-color: #F4F2EF;
  box-sizing: border-box;
}

.title {
  font-family: 'Times New Roman', 'Georgia', serif;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #777777;
  margin-top: 4rpx;
}

.score-badge {
  position: absolute;
  right: 48rpx;
  top: 108rpx;
  width: 152rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.score-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* ---- HeroCard (327x162px, cornerRadius:16) ---- */
.hero-card {
  width: calc(100% - 96rpx);
  height: 324rpx;
  margin: 8rpx 48rpx 0;
  padding: 40rpx 40rpx 16rpx;
  border-radius: 32rpx;
  background-color: #2D3E5F;
  background-image: url('/assets/images/bg/bg_hero_card.png');
  background-size: cover;
  background-position: center;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 12rpx 40rpx rgba(45, 62, 95, 0.15);
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  align-self: flex-start;
}

.hero-tag text {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-top: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-progress {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.56);
  margin-top: 16rpx;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  width: 240rpx;
  margin-top: 16rpx;
  border-radius: 36rpx;
  background: #C8B496;
  align-self: flex-start;
}

.hero-btn text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* ---- QuickActions (375x80, y:274, padding:[8,20,0,20]) ---- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  width: 100%;
  height: 160rpx;
  margin-top: 24rpx;
  padding: 16rpx 40rpx 0;
  background-color: #F4F2EF;
  box-sizing: border-box;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
}

.action-label {
  font-size: 24rpx;
  color: #4A4A4A;
  margin-top: 8rpx;
}

/* ---- ProgressSection (375x152, y:366) ---- */
.progress-section {
  width: 100%;
  height: 304rpx;
  margin-top: 24rpx;
  padding: 32rpx 48rpx 24rpx;
  background-color: #FFFFFF;
  background-image: url('/assets/images/bg/bg_progress_card.png');
  background-size: cover;
  background-position: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.02);
}

.prog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.prog-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.prog-detail {
  font-size: 24rpx;
  color: #777777;
}

.prog-bar-track {
  width: 100%;
  height: 20rpx;
  border-radius: 10rpx;
  background: #F4F2EF;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.prog-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #2D3E5F, #384F84);
  transition: width 600ms ease;
}

.prog-label {
  display: block;
  font-size: 26rpx;
  color: #777777;
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-val {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.stat-lab {
  font-size: 22rpx;
  color: #777777;
  margin-top: 4rpx;
}

/* ---- RecommendSection (375x182, y:524) ---- */
.recommend-section {
  width: 100%;
  height: 364rpx;
  margin-top: 12rpx;
  padding: 32rpx 48rpx 0;
  background-color: #F4F2EF;
  box-sizing: border-box;
}

.rec-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.rec-header .rec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.rec-more {
  font-size: 24rpx;
  color: #777777;
}

.rec-cards {
  display: flex;
  gap: 26rpx;
}

.rec-card {
  width: 314rpx;
  min-width: 314rpx;
  height: 260rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  background-image: url('/assets/images/bg/bg_rec_card.png');
  background-size: cover;
  background-position: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  padding: 20rpx;
  box-sizing: border-box;
}

.rec-thumb {
  width: 274rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: #E8EDF5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rec-thumb-img {
  width: 60rpx;
  height: 60rpx;
}

.rec-thumb-icon {
  font-size: 60rpx;
  opacity: 0.4;
}

.rec-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-card-desc {
  display: block;
  font-size: 22rpx;
  color: #777777;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 装饰元素 (绝对定位) ---- */
.deco {
  position: absolute;
  pointer-events: none;
}

.deco-wave-header {
  width: 60rpx;
  height: 16rpx;
  left: 320rpx;
  top: 110rpx;
}

.deco-circle-hero {
  width: 20rpx;
  height: 20rpx;
  right: 70rpx;
  top: 250rpx;
}

.deco-x-qa {
  width: 24rpx;
  height: 24rpx;
  left: 80rpx;
  top: 490rpx;
}

.deco-star-qa {
  width: 20rpx;
  height: 20rpx;
  left: 400rpx;
  top: 530rpx;
}

.deco-dot-progress {
  width: 12rpx;
  height: 12rpx;
  left: 60rpx;
  top: 720rpx;
}

.deco-dot-qa {
  width: 10rpx;
  height: 10rpx;
  right: 40rpx;
  top: 560rpx;
}

.deco-wave-tab {
  width: 48rpx;
  height: 12rpx;
  right: 62rpx;
  top: 1500rpx;
}
