/* ============================================
   知小记 · 主页 — Pencil RweGQ 1:1 像素级复刻
   设计稿 375px → 小程序 750rpx (×2)
   阴影: offset×2, blur×2, 颜色不变
   颜色: 全部走 CSS 变量，支持 light/dark 切换
   ============================================ */

.home-page {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== Scroll ===== */
.scroll-content {
  flex: 1;
  position: relative;
  z-index: 1;
}

.scroll-inner {
  position: relative;
}

.bottom-placeholder {
  height: 168rpx;
}

/* ============================================
   Header — 375×96 → 750×192rpx
   ============================================ */
.header {
  position: relative;
  z-index: 2;
  width: 750rpx;
  height: 192rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 54rpx 48rpx 0;
  box-sizing: border-box;
}

/* Title: Playfair Display, 24px→48rpx, 700 */
.title {
  font-family: 'Times New Roman', Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.25;
}

/* Subtitle: Inter, 13px→26rpx */
.subtitle {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
  margin-top: 0;
}

/* ============================================
   HeroCard — 327×160→654×320rpx
   fill: bg_hero_card.png (深蓝渐变背景图)
   文字保持白色（双主题一致，因 hero 背景始终深蓝）
   ============================================ */
.hero-card {
  position: relative;
  width: 654rpx;
  height: 320rpx;
  margin: 8rpx 48rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

/* inner padding: 20→40rpx */
.hero-inner {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

/* Tag: 88×24→176×48rpx, cornerRadius 12→24rpx, #FFFFFF20 */
.hero-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.125);
  align-self: flex-start;
}

/* TagText: Inter, 11px→22rpx, 500, #FFFFFF */
.hero-tag text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* HeroTitle: Inter, 20px→40rpx, 600, #FFFFFF */
.hero-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.25;
  margin-top: 20rpx;
}

/* HeroProgress: Inter, 13px→26rpx, #FFFFFF90 */
.hero-progress {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: normal;
  color: rgba(255, 255, 255, 0.56);
  margin-top: 16rpx;
}

/* HeroBtn: 120×36→240×72rpx, cornerRadius 18→36rpx, accent */
.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-accent);
  margin-top: 16rpx;
  align-self: flex-start;
}

/* HeroBtnText: Inter, 13px→26rpx, 600, #1A1A1A（深蓝底配深字） */
.hero-btn text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ScoreBadge: 68×24→136×48rpx, cornerRadius 15→30rpx, #FFFFFF */
.hero-score {
  position: absolute;
  right: 46rpx;
  top: 40rpx;
  width: 136rpx;
  height: 48rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.hero-score-text {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ============================================
   QuickActions — 375×82→750×164rpx
   ============================================ */
.quick-actions {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  width: 750rpx;
  height: 164rpx;
  margin-top: 28rpx;
  padding: 20rpx 40rpx 0;
  background: var(--color-bg);
  box-sizing: border-box;
}

/* Each QA item: vertical layout, gap:6→12rpx, alignItems center */
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* IconBg: 48×48→96×96rpx — 已从设计稿导出为 PNG（含圆角+背景）*/
.action-icon {
  width: 96rpx;
  height: 96rpx;
}

/* Label: Inter, 12px→24rpx, textAlign center */
.action-label {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  font-weight: normal;
  color: var(--color-text-secondary);
}

/* ============================================
   ProgressSection — 375×152→750×304rpx
   ============================================ */
.progress-section {
  position: relative;
  width: 750rpx;
  height: 304rpx;
  margin-top: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

/* inner: x:24→48rpx */
.prog-inner {
  position: relative;
  z-index: 1;
  padding: 32rpx 48rpx 0;
  height: 100%;
  box-sizing: border-box;
}

/* ProgHeader: 327×24→654×48rpx */
.prog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* ProgTitle: Inter, 15px→30rpx, 600 */
.prog-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ProgDetail: Inter, 12px→24rpx, textAlign right */
.prog-detail {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ProgBar: 327×10→654×20rpx, cornerRadius 5→10rpx */
.prog-bar {
  width: 100%;
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--color-divider);
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* ProgBarFill: gradient primary→primary-light */
.prog-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
}

/* ProgLabel: Inter, 13px→26rpx */
.prog-label {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

/* StatsRow: 327×36→654×72rpx, justifyContent space_between */
.stats-row {
  display: flex;
  justify-content: space-between;
}

/* Each Stat: 90×36→180×72rpx */
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 180rpx;
}

/* StatVal: Inter, 18px→36rpx, 600 */
.stat-val {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* StatLab: Inter, 11px→22rpx */
.stat-lab {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ============================================
   RecommendSection — 375×182→750×364rpx
   ============================================ */
.recommend-section {
  width: 750rpx;
  margin-top: 12rpx;
  padding: 32rpx 48rpx 0;
  background: var(--color-bg);
  box-sizing: border-box;
}

/* RecHeader: 327×24→654×48rpx */
.rec-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* RecTitle: Inter, 15px→30rpx, 600 */
.rec-title {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* RecMore: Inter, 12px→24rpx, textAlign right */
.rec-more {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* RecCards: gap 13→26rpx, height 130→260rpx */
.rec-cards {
  display: flex;
  gap: 26rpx;
}

/* RecCard: 157×130→314×260rpx, cornerRadius 14→28rpx, fill bg_rec_card.png */
.rec-card {
  position: relative;
  width: 314rpx;
  min-width: 314rpx;
  height: 260rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

/* inner: padding 10→20rpx */
.rec-inner {
  position: relative;
  z-index: 1;
  padding: 20rpx;
}

/* RecThumb: 137×70→274×140rpx, cornerRadius 10→20rpx, fill surface */
.rec-thumb {
  width: 274rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* RecImg: 30×30→60×60rpx */
.rec-thumb-img {
  width: 60rpx;
  height: 60rpx;
}

.rec-thumb-emoji {
  font-size: 60rpx;
  opacity: 0.4;
}

/* RecCardTitle: Inter, 13px→26rpx, 600 */
.rec-card-title {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 16rpx;
}

/* RecDesc: Inter, 11px→22rpx */
.rec-card-desc {
  display: block;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* ============================================
   装饰元素 — 绝对定位
   设计稿坐标 ×2 → rpx
   ============================================ */
.deco {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

/* l3koZ: deco_wave, 30×8→60×16rpx, x:160→320rpx, y:55→110rpx */
.deco-wave-header { top: 110rpx; left: 320rpx; width: 60rpx; height: 16rpx; }

/* 0CrEZ: deco_circle, 10×10→20×20rpx, x:330→660rpx, y:125→250rpx */
.deco-circle-hero { top: 250rpx; right: 90rpx; width: 20rpx; height: 20rpx; }

/* 1YU8g: HomeX path, 12×12→24×24rpx, stroke #C8B496, x:40→80rpx, y:245→490rpx */
.deco-x { top: 490rpx; left: 80rpx; width: 24rpx; height: 24rpx; }

/* s2eME: HomeStar path, 10×10→20×20rpx, x:200→400rpx, y:265→530rpx */
.deco-star { top: 530rpx; left: 400rpx; width: 20rpx; height: 20rpx; }

/* PIA1k: HomeDot1 ellipse, 6×6→12×12rpx, x:30→60rpx, y:360→720rpx */
.deco-dot1 { top: 720rpx; left: 60rpx; width: 12rpx; height: 12rpx; }

/* lKgKQ: HomeDot2 ellipse, 5×5→10×10rpx, x:350→700rpx, y:280→560rpx */
.deco-dot2 { top: 560rpx; right: 50rpx; width: 10rpx; height: 10rpx; }

/* p9NIK: deco_wave2, 24×6→48×12rpx, x:320→640rpx, y:750→1500rpx */
.deco-wave-bottom { top: 1500rpx; right: 110rpx; width: 48rpx; height: 12rpx; }
