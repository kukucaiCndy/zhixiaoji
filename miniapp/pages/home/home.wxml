<view class="home-page" data-theme="{{theme}}">
  <!-- 页面背景 -->
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Header -->
  <view class="header">
    <image class="header-bg" src="/assets/images/{{theme}}/bg/bg_navbar.png" mode="aspectFill" />
    <view class="header-content">
      <text class="title">知小记</text>
      <text class="subtitle">准备好继续学习了吗？</text>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-inner">

      <!-- Hero Card -->
      <view class="hero-card" bindtap="onContinueLearn">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_hero_card.png" mode="aspectFill" />
        <view class="hero-inner">
          <view class="hero-tag">
            <text>今日续学</text>
          </view>
          <text class="hero-title">{{continueTitle || 'Python 基础 · 第3章'}}</text>
          <text class="hero-progress">已完成 {{overallPercent || 68}}%</text>
          <view class="hero-btn">
            <text>继续学习</text>
          </view>
        </view>
        <view class="hero-score">
          <text class="hero-score-text">{{points || '1,280'}}</text>
        </view>
      </view>

      <!-- Quick Actions — icons exported from Pencil design稿 -->
      <view class="quick-actions">
        <view class="action-item" bindtap="onChallenge">
          <image class="action-icon" src="/assets/images/icons/qa_trophy.png" mode="aspectFit" />
          <text class="action-label">挑战</text>
        </view>
        <view class="action-item" bindtap="onStartReview">
          <image class="action-icon" src="/assets/images/icons/qa_review.png" mode="aspectFit" />
          <text class="action-label">复习</text>
        </view>
        <view class="action-item" bindtap="onRankTap">
          <image class="action-icon" src="/assets/images/icons/qa_rank.png" mode="aspectFit" />
          <text class="action-label">排行</text>
        </view>
        <view class="action-item" bindtap="onAchievementTap">
          <image class="action-icon" src="/assets/images/icons/qa_achievement.png" mode="aspectFit" />
          <text class="action-label">成就</text>
        </view>
      </view>

      <!-- Progress Section -->
      <view class="progress-section">
        <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_progress_card.png" mode="aspectFill" />
        <view class="prog-inner">
          <view class="prog-header">
            <text class="prog-title">我的学习进度</text>
            <text class="prog-detail" bindtap="onViewDetail">详情 ›</text>
          </view>
          <view class="prog-bar">
            <view class="prog-bar-fill" style="width: {{overallPercent || 68}}%"></view>
          </view>
          <text class="prog-label">已完成 {{overallPercent || 68}}%</text>
          <view class="stats-row">
            <view class="stat-item">
              <text class="stat-val">{{stats.toLearn || 12}}</text>
              <text class="stat-lab">待学习</text>
            </view>
            <view class="stat-item">
              <text class="stat-val">{{stats.mastered || 45}}</text>
              <text class="stat-lab">已掌握</text>
            </view>
            <view class="stat-item">
              <text class="stat-val">{{stats.accuracy || 86}}%</text>
              <text class="stat-lab">正确率</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Recommend Section -->
      <view class="recommend-section">
        <view class="rec-header">
          <text class="rec-title">为你推荐</text>
          <text class="rec-more" bindtap="onMore">更多 ›</text>
        </view>
        <view class="rec-cards">
          <view wx:for="{{recommendations}}" wx:key="id" class="rec-card" bindtap="onRecommendTap" data-id="{{item.id}}">
            <image class="card-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
            <view class="rec-inner">
              <view class="rec-thumb">
                <image wx:if="{{item.iconType === 'image'}}" class="rec-thumb-img" src="{{item.icon}}" mode="aspectFit" />
                <text wx:else class="rec-thumb-emoji">{{item.icon || '📘'}}</text>
              </view>
              <text class="rec-card-title">{{item.title}}</text>
              <text class="rec-card-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 装饰元素 -->
      <image class="deco deco-wave-header" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />
      <image class="deco deco-circle-hero" src="/assets/images/{{theme}}/deco/deco_circle.png" mode="aspectFit" />
      <image class="deco deco-x" src="/assets/images/{{theme}}/deco/deco_sparkle.png" mode="aspectFit" />
      <image class="deco deco-star" src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      <image class="deco deco-dot1" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />
      <image class="deco deco-dot2" src="/assets/images/{{theme}}/deco/deco_dot.png" mode="aspectFit" />
      <image class="deco deco-wave-bottom" src="/assets/images/{{theme}}/deco/deco_wave.png" mode="aspectFit" />

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <tab-bar activeIndex="0" bind:change="onTabChange"></tab-bar>
</view>
