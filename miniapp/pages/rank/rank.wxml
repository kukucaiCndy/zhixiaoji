<view class="rank-page" data-theme="{{theme}}">
  <image class="bg-page" src="/assets/images/{{theme}}/bg/bg_page.png" mode="aspectFill" />

  <!-- Nav -->
  <nav-bar title="排行榜"></nav-bar>

  <!-- Top 3 -->
  <view class="top3">
    <!-- 2nd Place -->
    <view class="top-item top-2">
      <image class="top-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <view class="top-badge top-badge--silver">2</view>
      <view class="top-avatar top-avatar--2">
        <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      </view>
      <text class="top-name">{{topList[1].name || '小明'}}</text>
      <text class="top-score">{{topList[1].score || '1250'}}</text>
    </view>

    <!-- 1st Place -->
    <view class="top-item top-1">
      <view class="top-badge top-badge--gold">1</view>
      <view class="top-avatar top-avatar--1">
        <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      </view>
      <text class="top-name top-name--1">{{topList[0].name || '学霸'}}</text>
      <text class="top-score top-score--1">{{topList[0].score || '1580'}}</text>
    </view>

    <!-- 3rd Place -->
    <view class="top-item top-3">
      <image class="top-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <view class="top-badge top-badge--bronze">3</view>
      <view class="top-avatar top-avatar--3">
        <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
      </view>
      <text class="top-name">{{topList[2].name || '小红'}}</text>
      <text class="top-score">{{topList[2].score || '980'}}</text>
    </view>
  </view>

  <!-- List title -->
  <text class="section-title">完整排名</text>

  <!-- Rank List -->
  <scroll-view class="rank-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="rank-item {{item.isMe ? 'rank-item--me' : ''}}" wx:for="{{rankList}}" wx:key="id">
      <image wx:if="{{!item.isMe}}" class="rank-item-bg" src="/assets/images/{{theme}}/bg/bg_rec_card.png" mode="aspectFill" />
      <view class="rank-item-inner">
        <text class="rank-pos">{{item.pos}}</text>
        <view class="rank-avatar">
          <image src="/assets/images/{{theme}}/deco/deco_star.png" mode="aspectFit" />
        </view>
        <text class="rank-name">{{item.name}}</text>
        <text class="rank-score">{{item.score}}</text>
      </view>
    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
