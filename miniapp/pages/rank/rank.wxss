.rank-page {
  width: 100vw;
  min-height: 100vh;
  background: #F0F2F5;
  overflow-x: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  height: 88rpx;
  background: #FFFFFF;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.status-icons {
  display: flex;
  gap: 8rpx;
  align-items: flex-end;
}

.signal-bar {
  width: 36rpx;
  height: 20rpx;
  background: rgba(28, 28, 30, 0.4);
  border-radius: 4rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.back-btn {
  width: 60rpx;
  flex-shrink: 0;
}

.back-icon {
  font-size: 34rpx;
  color: #1C1C1E;
}

.nav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  color: #1C1C1E;
}

.nav-my-rank {
  flex-shrink: 0;
}

.nav-my-rank text {
  font-size: 26rpx;
  color: #4F46E5;
  font-weight: 500;
}

.tab-bar {
  display: flex;
  padding: 0 32rpx;
  background: #FFFFFF;
  gap: 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-item text {
  font-size: 26rpx;
  color: #8E8E93;
}

.tab-item.active text {
  color: #4F46E5;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #4F46E5;
  border-radius: 3rpx;
}

.my-rank-card {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #EEF2FF 0%, #FFFFFF 100%);
  border-radius: 28rpx;
  border: 2rpx solid #EEF2FF;
  gap: 20rpx;
}

.my-rank-pos {
  font-size: 28rpx;
  font-weight: 700;
  color: #4F46E5;
}

.my-rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.my-rank-avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.my-rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.my-rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.my-rank-change {
  font-size: 22rpx;
  color: #8E8E93;
}

.my-rank-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #4F46E5;
}

.rank-list {
  padding: 0 32rpx 160rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  gap: 24rpx;
}

.ri-pos {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ri-pos text {
  font-size: 28rpx;
  font-weight: 700;
}

.ri-pos-normal {
  background: transparent;
}

.ri-pos-normal text {
  color: #8E8E93;
}

.ri-pos-top {
  background: #EEF2FF;
}

.ri-pos-top text {
  color: #4F46E5;
}

.ri-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ri-avatar text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.ri-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ri-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ri-name text:first-child {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.ri-badge {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.ri-meta {
  font-size: 22rpx;
  color: #8E8E93;
}

.ri-score {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
  letter-spacing: 0.4rpx;
}

.ri-trend {
  font-size: 24rpx;
  flex-shrink: 0;
}

.trend-up {
  color: #10B981;
}

.trend-down {
  color: #EF4444;
}

.trend-flat {
  color: #8E8E93;
}