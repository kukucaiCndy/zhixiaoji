.rank-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.bg-page {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.rank-item-bg, .top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== Top 3 ===== */
.top3 {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 24rpx;
  margin: 24rpx 48rpx;
  height: 320rpx;
}

.top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 28rpx;
  position: relative;
}

.top-2, .top-3 { width: 200rpx; height: 260rpx; overflow: hidden; }
.top-2 { padding-top: 40rpx; }
.top-3 { padding-top: 40rpx; }

.top-1 {
  width: 200rpx;
  height: 300rpx;
  background: var(--color-primary);
  border-radius: 28rpx;
  padding-top: 48rpx;
}

.top-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  position: absolute;
  top: -20rpx;
}

.top-badge--gold { background: #FFD700; color: var(--color-text); }
.top-badge--silver { background: #C0C0C0; color: var(--color-text); }
.top-badge--bronze { background: #CD7F32; color: #FFFFFF; }

.top-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.top-avatar image { width: 48rpx; height: 48rpx; }
.top-avatar--1 { background: rgba(255, 255, 255, 0.19); }
.top-avatar--2 { background: var(--color-surface); }
.top-avatar--3 { background: var(--color-surface); }

.top-name {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

.top-name--1 { color: #FFFFFF; }

.top-score {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-warning);
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.top-score--1 { color: var(--color-accent); }

/* ===== Section Title ===== */
.section-title {
  position: relative;
  z-index: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin: 8rpx 48rpx 16rpx;
}

/* ===== Rank List ===== */
.rank-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 0 48rpx;
}

.bottom-placeholder { height: 40rpx; }

.rank-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.rank-item--me {
  background: var(--color-primary);
}

.rank-item-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.rank-pos {
  width: 40rpx;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  text-align: center;
}

.rank-item--me .rank-pos { color: var(--color-accent); }

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-item--me .rank-avatar { background: rgba(255, 255, 255, 0.19); }

.rank-avatar image { width: 32rpx; height: 32rpx; }

.rank-name {
  flex: 1;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.rank-item--me .rank-name { color: #FFFFFF; }

.rank-score {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.rank-item--me .rank-score { color: var(--color-accent); }
