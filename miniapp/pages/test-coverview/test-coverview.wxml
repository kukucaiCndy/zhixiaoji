<web-view src="{{url}}">
  <!-- 测试1: 最简 cover-view，固定顶部 -->
  <cover-view style="position:fixed; top:50px; left:0; width:100%; height:40px; background:red; color:white; text-align:center; line-height:40px;">
    TOP BAR - 红色条
  </cover-view>
  
  <!-- 测试2: 固定底部 -->
  <cover-view style="position:fixed; bottom:0; left:0; width:100%; height:60px; background:blue; color:white; display:flex; flex-direction:row; align-items:center; justify-content:space-around;">
    <cover-view style="padding:0 20px; background:green; border-radius:10px;" bindtap="onTap1">按钮1</cover-view>
    <cover-view style="padding:0 20px; background:orange; border-radius:10px;" bindtap="onTap2">按钮2</cover-view>
    <cover-view style="padding:0 20px; background:purple; border-radius:10px;" bindtap="onTap3">按钮3</cover-view>
  </cover-view>
</web-view>
