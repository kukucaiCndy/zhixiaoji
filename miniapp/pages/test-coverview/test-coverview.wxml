<web-view wx:if="{{hasUrl}}" src="{{url}}">
  <cover-view style="position:fixed; top:50px; left:0; width:100%; height:40px; background:red; color:white; text-align:center; line-height:40px;">
    TOP BAR - 有URL
  </cover-view>
  <cover-view style="position:fixed; bottom:0; left:0; width:100%; height:60px; background:blue; color:white; display:flex; flex-direction:row; align-items:center; justify-content:space-around;">
    <cover-view style="padding:0 20px; background:green; border-radius:10px;" bindtap="onTap1">按钮1</cover-view>
    <cover-view style="padding:0 20px; background:orange; border-radius:10px;" bindtap="onTap2">按钮2</cover-view>
    <cover-view style="padding:0 20px; background:purple; border-radius:10px;" bindtap="onTap3">按钮3</cover-view>
  </cover-view>
</web-view>

<web-view wx:else>
  <cover-view style="position:fixed; top:50px; left:0; width:100%; height:40px; background:green; color:white; text-align:center; line-height:40px;">
    TOP BAR - 无URL
  </cover-view>
  <cover-view style="position:fixed; bottom:0; left:0; width:100%; height:60px; background:gray; color:white; display:flex; flex-direction:row; align-items:center; justify-content:space-around;">
    <cover-view style="padding:0 20px; background:green; border-radius:10px;" bindtap="onTap1">按钮1</cover-view>
    <cover-view style="padding:0 20px; background:orange; border-radius:10px;" bindtap="onTap2">按钮2</cover-view>
    <cover-view style="padding:0 20px; background:purple; border-radius:10px;" bindtap="onTap3">按钮3</cover-view>
  </cover-view>
</web-view>

<cover-view style="position:fixed; top:{{statusBarHeight}}px; right:20px; padding:10px 16px; background:#4F46E5; color:white; border-radius:8px; font-size:14px;" bindtap="onToggle">
  {{hasUrl ? '去掉URL' : '设置URL'}}
</cover-view>
